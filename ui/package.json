{
  "name": "@imagile-dev/toil-ui",
  "version": "0.1.0-alpha.1",
  "description": "Toil UI: a local web app to see and reason about work across Jira, Azure DevOps and GitHub, on toil. Alpha, local only.",
  "license": "Apache-2.0",
  "author": "Imagile",
  "homepage": "https://imagile-dev.github.io/toil/docs/ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imagile-dev/toil.git",
    "directory": "ui"
  },
  "bugs": "https://github.com/imagile-dev/toil/issues",
  "type": "module",
  "bin": {
    "toil-ui": "dist/server/toil-ui.js"
  },
  "files": [
    "dist/server/toil-ui.js",
    "dist/app/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24.14"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode app && vite build --config vite.server.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.registry.json && tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check:package": "node scripts/check-package.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@imagile-dev/toil": "0.1.0-alpha.3"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.289",
    "@github/copilot-sdk": ">=1.0.16",
    "@openai/codex-sdk": ">=0.160.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@github/copilot-sdk": {
      "optional": true
    },
    "@openai/codex-sdk": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@dnd-kit/core": "6.3.1",
    "@eslint/js": "10.0.1",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/cinzel-decorative": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/exo-2": "5.3.0",
    "@fontsource/fira-code": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/orbitron": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@xyflow/react": "12.12.0",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "jsdom": "29.1.1",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
