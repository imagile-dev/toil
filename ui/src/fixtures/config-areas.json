[
  {
    "name": "ado",
    "description": "Azure DevOps Server and Azure DevOps Services: work items, boards, sprints, repositories, pull requests and pipelines",
    "connection": [
      {
        "name": "baseUrl",
        "description": "Server: the root, e.g. https://ado.imagile.dev (keep any /tfs prefix). Services: the organization URL, https://dev.azure.com/<organization> (or https://<organization>.visualstudio.com)",
        "secret": false,
        "password": false,
        "default": null,
        "required": true,
        "choices": {
          "options": [
            {
              "label": "Your Azure DevOps organization",
              "value": null,
              "when": {
                "deployment": "cloud"
              },
              "compose": {
                "prefix": "https://dev.azure.com/",
                "label": "Organization",
                "placeholder": "example-org"
              }
            },
            {
              "label": "Your Azure DevOps Server",
              "value": null,
              "when": {
                "deployment": "server"
              },
              "placeholder": "https://ado.imagile.dev"
            }
          ]
        }
      },
      {
        "name": "deployment",
        "description": "Which Azure DevOps this is: \"server\" for Azure DevOps Server (the default), or \"cloud\" for Azure DevOps Services",
        "secret": false,
        "password": false,
        "default": "server",
        "required": false,
        "choices": {
          "question": "Which one is it?",
          "required": true,
          "options": [
            {
              "label": "Services (cloud)",
              "value": "cloud",
              "hosts": [
                "dev.azure.com",
                "*.visualstudio.com"
              ]
            },
            {
              "label": "Server",
              "value": "server"
            }
          ]
        }
      },
      {
        "name": "collection",
        "description": "Server only: default collection, when --collection isn't given",
        "secret": false,
        "password": false,
        "default": null,
        "required": false,
        "appliesTo": [
          "server"
        ]
      },
      {
        "name": "project",
        "description": "Default team project, when --project isn't given",
        "secret": false,
        "password": false,
        "default": null,
        "required": false
      },
      {
        "name": "repo",
        "description": "Default git repository, when --repo isn't given",
        "secret": false,
        "password": false,
        "default": null,
        "required": false
      },
      {
        "name": "team",
        "description": "Services only: default team for the board, backlog and sprint commands, when --team isn't given (else the project's default team)",
        "secret": false,
        "password": false,
        "default": null,
        "required": false,
        "appliesTo": [
          "cloud"
        ]
      },
      {
        "name": "fieldAliases",
        "description": "Work item field aliases, friendly name to reference name (e.g. {\"storypoints\": \"Microsoft.VSTS.Scheduling.StoryPoints\"})",
        "secret": false,
        "password": false,
        "default": null,
        "required": false
      },
      {
        "name": "discoveredFields",
        "description": "Server only: work item fields recorded by an earlier discovery; kept, not read",
        "secret": false,
        "password": false,
        "default": null,
        "required": false,
        "appliesTo": [
          "server"
        ]
      },
      {
        "name": "discoveredTypes",
        "description": "Server only: work item types recorded by an earlier discovery; kept, not read",
        "secret": false,
        "password": false,
        "default": null,
        "required": false,
        "appliesTo": [
          "server"
        ]
      },
      {
        "name": "pat",
        "description": "Personal access token. Services: an organization-scoped one",
        "secret": true,
        "password": false,
        "default": null,
        "required": true
      }
    ],
    "variantBy": "deployment"
  },
  {
    "name": "bitbucket",
    "description": "Bitbucket Data Center and Bitbucket Cloud: repositories, branches, tags, commits, files, pull requests, comments, reviewers, build statuses and Pipelines",
    "connection": [
      {
        "name": "baseUrl",
        "description": "Bitbucket root: the Data Center server (https://bitbucket.imagile.dev), or the Cloud REST API root (https://api.bitbucket.org/2.0)",
        "secret": false,
        "password": false,
        "default": null,
        "required": true,
        "choices": {
          "options": [
            {
              "label": "Bitbucket Cloud (https://api.bitbucket.org/2.0)",
              "value": "https://api.bitbucket.org/2.0",
              "when": {
                "deployment": "cloud"
              }
            },
            {
              "label": "Your Bitbucket server",
              "value": null,
              "when": {
                "deployment": "server"
              },
              "placeholder": "https://bitbucket.imagile.dev"
            }
          ]
        }
      },
      {
        "name": "deployment",
        "description": "Which Bitbucket this is: \"server\" for Data Center (the default), or \"cloud\" for Bitbucket Cloud",
        "secret": false,
        "password": false,
        "default": "server",
        "required": false,
        "choices": {
          "question": "Which one is it?",
          "required": true,
          "options": [
            {
              "label": "Cloud",
              "value": "cloud",
              "hosts": [
                "bitbucket.org",
                "api.bitbucket.org"
              ]
            },
            {
              "label": "Data Center",
              "value": "server"
            }
          ]
        }
      },
      {
        "name": "email",
        "description": "Bitbucket Cloud only: the email address of the Atlassian account an API token belongs to (with apiToken)",
        "secret": false,
        "password": false,
        "default": null,
        "required": false,
        "appliesTo": [
          "cloud"
        ]
      },
      {
        "name": "project",
        "description": "Data Center: default project key",
        "secret": false,
        "password": false,
        "default": null,
        "required": false,
        "appliesTo": [
          "server"
        ]
      },
      {
        "name": "workspace",
        "description": "Bitbucket Cloud: default workspace slug",
        "secret": false,
        "password": false,
        "default": null,
        "required": false,
        "appliesTo": [
          "cloud"
        ]
      },
      {
        "name": "repo",
        "description": "Default repository slug",
        "secret": false,
        "password": false,
        "default": null,
        "required": false
      },
      {
        "name": "targetBranch",
        "description": "Data Center: default target branch for pr create (main when unset)",
        "secret": false,
        "password": false,
        "default": null,
        "required": false,
        "appliesTo": [
          "server"
        ]
      },
      {
        "name": "pat",
        "description": "Data Center: an HTTP access token",
        "secret": true,
        "password": false,
        "default": null,
        "required": false,
        "appliesTo": [
          "server"
        ],
        "requiredFor": [
          "server"
        ]
      },
      {
        "name": "apiToken",
        "description": "Bitbucket Cloud only: an Atlassian API token with Bitbucket scopes, sent as Basic auth with email",
        "secret": true,
        "password": false,
        "default": null,
        "required": false,
        "appliesTo": [
          "cloud"
        ]
      },
      {
        "name": "accessToken",
        "description": "Bitbucket Cloud only: a workspace, project or repository access token, sent as Bearer",
        "secret": true,
        "password": false,
        "default": null,
        "required": false,
        "appliesTo": [
          "cloud"
        ]
      }
    ],
    "variantBy": "deployment"
  },
  {
    "name": "github",
    "description": "GitHub and GitHub Enterprise Server: pull requests, reviews, comments, checks, labels, assignees, issues and projects",
    "connection": [
      {
        "name": "baseUrl",
        "description": "REST API root: https://api.github.com, or https://ghe.imagile.dev/api/v3 for Enterprise Server",
        "secret": false,
        "password": false,
        "default": null,
        "required": true,
        "choices": {
          "question": "Which GitHub is it?",
          "options": [
            {
              "label": "GitHub.com (https://api.github.com)",
              "value": "https://api.github.com",
              "hosts": [
                "api.github.com"
              ]
            },
            {
              "label": "GitHub Enterprise Server",
              "value": null,
              "placeholder": "https://ghe.imagile.dev/api/v3",
              "expectPath": "/api/v3"
            }
          ]
        }
      },
      {
        "name": "owner",
        "description": "Default owner (user or org)",
        "secret": false,
        "password": false,
        "default": null,
        "required": false
      },
      {
        "name": "repo",
        "description": "Default repository name",
        "secret": false,
        "password": false,
        "default": null,
        "required": false
      },
      {
        "name": "targetBranch",
        "description": "Default base branch for pr create (main when unset)",
        "secret": false,
        "password": false,
        "default": null,
        "required": false
      },
      {
        "name": "token",
        "description": "Personal access token, classic (ghp_...) or fine-grained (github_pat_...)",
        "secret": true,
        "password": false,
        "default": null,
        "required": true
      }
    ],
    "scopes": {
      "secret": "token",
      "otherPrefixes": {
        "gho_": "an OAuth token",
        "ghu_": "an app user token",
        "ghs_": "an app installation token",
        "ghr_": "an app refresh token"
      },
      "kinds": [
        {
          "id": "classic",
          "label": "Classic token",
          "tokenPrefix": "ghp_",
          "summary": "The common kind: one token, scopes ticked on one page, works on every repository you can reach.",
          "createUrl": "https://github.com/settings/tokens/new",
          "readOnly": {
            "needs": [
              "repo",
              "read:project"
            ],
            "createUrl": "https://github.com/settings/tokens/new?scopes=repo,read:project&description=toil"
          },
          "everything": {
            "needs": [
              "repo",
              "read:project"
            ],
            "createUrl": "https://github.com/settings/tokens/new?scopes=repo,read:project&description=toil"
          },
          "entries": [
            {
              "name": "repo",
              "required": "read",
              "commands": [
                "github pr list",
                "github pr get",
                "github pr diff",
                "github pr files",
                "github pr comments",
                "github pr review-comments",
                "github pr reviews",
                "github pr reviewers",
                "github pr threads",
                "github pr status",
                "github pr create",
                "github pr update",
                "github pr close",
                "github pr reopen",
                "github pr draft",
                "github pr ready",
                "github pr merge",
                "github pr comment",
                "github pr comment-inline",
                "github pr reply",
                "github pr delete-comment",
                "github pr delete-review-comment",
                "github pr approve",
                "github pr request-changes",
                "github pr add-reviewers",
                "github pr remove-reviewers",
                "github pr resolve",
                "github pr enable-auto-merge",
                "github pr disable-auto-merge",
                "github pr enqueue",
                "github issue list",
                "github issue search",
                "github issue get",
                "github issue history",
                "github issue create",
                "github issue label",
                "github issue unlabel",
                "github issue assign",
                "github issue unassign",
                "github repo file",
                "github repo create",
                "github commit status",
                "github commit checks",
                "github check-toil-project"
              ],
              "note": "GitHub has no read-only form of repo. toil's own write gate keeps it read-only until you turn writes on. Public repositories alone need only public_repo."
            },
            {
              "name": "read:project",
              "required": "read",
              "commands": [
                "github project list",
                "github project fields",
                "github project items"
              ],
              "note": "Reading Projects (v2). toil never changes a project, so the project scope is not needed."
            }
          ]
        },
        {
          "id": "fine-grained",
          "label": "Fine-grained token",
          "tokenPrefix": "github_pat_",
          "summary": "Limited to the repositories you pick, with each permission set to Read or Read and write. Cannot read your own account-level Projects.",
          "createUrl": "https://github.com/settings/personal-access-tokens/new",
          "readOnly": {
            "needs": [
              "Metadata: Read",
              "Pull requests: Read",
              "Contents: Read",
              "Issues: Read",
              "Checks: Read",
              "Commit statuses: Read",
              "Projects (organization permission): Read"
            ],
            "createUrl": "https://github.com/settings/personal-access-tokens/new"
          },
          "everything": {
            "needs": [
              "Metadata: Read",
              "Pull requests: Read and write",
              "Contents: Read and write",
              "Issues: Read and write",
              "Checks: Read",
              "Commit statuses: Read",
              "Projects (organization permission): Read",
              "Administration: Read and write"
            ],
            "createUrl": "https://github.com/settings/personal-access-tokens/new"
          },
          "entries": [
            {
              "name": "Metadata",
              "access": "read",
              "required": "read",
              "commands": [
                "github check-toil-project"
              ],
              "note": "GitHub grants it to every fine-grained token."
            },
            {
              "name": "Pull requests",
              "access": "read",
              "required": "read",
              "commands": [
                "github pr list",
                "github pr get",
                "github pr diff",
                "github pr files",
                "github pr comments",
                "github pr review-comments",
                "github pr reviews",
                "github pr reviewers",
                "github pr threads",
                "github pr status"
              ]
            },
            {
              "name": "Pull requests",
              "access": "write",
              "required": "write",
              "commands": [
                "github pr create",
                "github pr update",
                "github pr close",
                "github pr reopen",
                "github pr draft",
                "github pr ready",
                "github pr merge",
                "github pr comment",
                "github pr comment-inline",
                "github pr reply",
                "github pr delete-comment",
                "github pr delete-review-comment",
                "github pr approve",
                "github pr request-changes",
                "github pr add-reviewers",
                "github pr remove-reviewers",
                "github pr resolve",
                "github pr enable-auto-merge",
                "github pr disable-auto-merge",
                "github pr enqueue"
              ]
            },
            {
              "name": "Contents",
              "access": "read",
              "required": "read",
              "commands": [
                "github repo file"
              ]
            },
            {
              "name": "Contents",
              "access": "write",
              "required": "write",
              "commands": [
                "github pr merge",
                "github pr enable-auto-merge",
                "github pr enqueue"
              ],
              "note": "Merging a pull request needs Contents as well as Pull requests."
            },
            {
              "name": "Issues",
              "access": "read",
              "required": "read",
              "commands": [
                "github issue list",
                "github issue search",
                "github issue get",
                "github issue history"
              ]
            },
            {
              "name": "Issues",
              "access": "write",
              "required": "write",
              "commands": [
                "github issue create",
                "github issue label",
                "github issue unlabel",
                "github issue assign",
                "github issue unassign"
              ]
            },
            {
              "name": "Checks",
              "access": "read",
              "required": "read",
              "commands": [
                "github commit checks",
                "github pr get",
                "github pr status"
              ],
              "note": "pr get needs it only with --include checks."
            },
            {
              "name": "Commit statuses",
              "access": "read",
              "required": "read",
              "commands": [
                "github commit status",
                "github pr status"
              ]
            },
            {
              "name": "Projects (organization permission)",
              "access": "read",
              "required": "read",
              "commands": [
                "github project list",
                "github project fields",
                "github project items"
              ],
              "note": "Only an organization's projects. A fine-grained token can't read a user's own; use a classic token for those."
            },
            {
              "name": "Administration",
              "access": "write",
              "required": "write",
              "commands": [
                "github repo create"
              ],
              "note": "For a repository under an organization. GitHub may refuse a fine-grained token for one under your own account; use a classic token for that."
            }
          ]
        }
      ]
    }
  },
