---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { url } from '../../lib/url';
import { categories, depsCommands, integrationCount, databaseCount, levels } from '../../data/integrations';

// Everything toil talks to, in one catalogue (#431): the integration areas and
// the database engines side by side, each with its verification level and how
// it signs in. Every tile comes from a data file; nothing here is a list typed
// by hand, which is the only kind of inventory that stays accurate.
---

<Layout title="Connect" description={`The ${integrationCount} integrations and ${databaseCount} database engines toil connects to, how each signs in, and how far each has been verified.`}>
  <PageHero
    eyebrow={`<b>${integrationCount}</b> integrations · <b>${databaseCount}</b> database engines`}
    title="Everything toil <em>connects to.</em>"
    lead="Each one is a command area or a database engine. It signs in with a token or account you set up once, and returns the same JSON envelope."
  >
    <nav class="jump" aria-label="Categories">
      <ul>
        {categories.map((c) => <li><a class="tap" href={`#${c.id}`}>{c.title}</a></li>)}
      </ul>
    </nav>
  </PageHero>

  <section class="section--tight levels-wrap">
    <div class="container">
      <ol class="levels" data-reveal>
        {levels.map((l) => (
          <li>
            <span class={`status status--${l.name}`}>{l.name}</span>
            <p>{l.meaning}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {categories.map((c) => (
    <section class="section--tight group" id={c.id} aria-labelledby={`${c.id}-title`}>
      <div class="container">
        <header class="group__head" data-reveal>
          <h2 id={`${c.id}-title`}>{c.title}</h2>
          <p>{c.blurb}</p>
        </header>
        <ul class="tiles">
          {c.items.map((i, n) => (
            <li class="card tile" data-reveal style={`--d: ${n * 70}ms`}>
              <div class="tile__top">
                <code class="tile__area">{i.tag}</code>
                <span class={`status status--${i.status}`}>{i.status}</span>
              </div>
              <h3><a class="tile__link" href={url(i.href)}>{i.name}</a></h3>
              {i.covers && <p>{i.covers}</p>}
              <p class="tile__cred"><span>Sign-in</span> {i.credential}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="section section--rule deps" id="dependency-checks">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Dependency checks</p>
        <h2>One command per source. You compose.</h2>
        <p>No single command quietly asks four services on your behalf. Build an inventory locally, then pipe it to exactly the sources you trust, and every finding says where it came from.</p>
      </div>
      <div class="codeblock deps__pipe" data-reveal>
        <span class="card-tag">compose</span>
<pre tabindex="0" role="region" aria-label="Composing the dependency commands"><span class="p">$</span> toil deps scan <span class="p">|</span> toil osv vulns
<span class="p">$</span> toil deps scan <span class="k">&gt;</span> inventory.json
<span class="p">$</span> toil sonatypeiq evaluate <span class="k">--from</span> inventory.json <span class="k">--application-id</span> <span class="s">payments-api</span></pre>
      </div>
      <div class="table-wrap" data-reveal tabindex="0" role="region" aria-label="Dependency commands">
        <table>
          <thead><tr><th>Command</th><th>Source</th><th>Covers</th><th>Network</th></tr></thead>
          <tbody>
            {depsCommands.map((d) => (
              <tr>
                <td><code>{d.command}</code></td>
                <td>{d.source}</td>
                <td>{d.covers}</td>
                <td>{d.network}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Layout>

<style>
  .jump ul { display: flex; flex-wrap: wrap; gap: 0 1.2rem; margin-top: var(--space-sm); font-size: var(--text-sm); }
  .jump a { color: var(--color-muted); font-family: var(--font-action); font-weight: 500; }
  .jump a:hover { color: var(--color-accent); }

  .levels-wrap { padding-block: var(--space-lg); }

  .levels {
    display: grid;
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .levels li { background: var(--color-bg); padding: var(--space-sm) var(--space-md); display: grid; gap: 0.4rem; align-content: start; }
  .levels p { color: var(--color-muted); font-size: var(--text-sm); }
  @media (min-width: 760px) { .levels { grid-template-columns: repeat(3, 1fr); } }

  .status {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--color-line-strong);
    color: var(--color-muted);
  }
  .status::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .status--unit { color: var(--color-muted); }
  .status--live { color: var(--color-accent); border-color: color-mix(in oklab, var(--color-accent) 50%, transparent); }
  .status--stable { color: var(--color-ok); border-color: color-mix(in oklab, var(--color-ok) 50%, transparent); }

  @media (prefers-reduced-motion: no-preference) {
    .status--live::before { animation: dot 2s ease-in-out infinite; }
  }
  @keyframes dot { 50% { opacity: 0.3; } }

  .group { padding-block: var(--space-lg); scroll-margin-top: 64px; }
  .group__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 1rem; margin-bottom: var(--space-md); }
  .group__head h2 { font-size: var(--text-2xl); }
  .group__head p { color: var(--color-muted); }

  .tiles { display: grid; gap: var(--space-sm); }
  @media (min-width: 640px) { .tiles { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .tiles { grid-template-columns: repeat(3, 1fr); } }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    transition: transform var(--duration-base) var(--ease-out), border-color var(--duration-base) var(--ease-out), background var(--duration-base) var(--ease-out);
  }
  .tile:hover { transform: translateY(-3px); border-color: color-mix(in oklab, var(--color-accent) 40%, var(--color-line)); background: var(--color-surface-raised); }

  .tile__top { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .tile__area { font-size: 0.75rem; color: var(--color-accent); }
  .tile h3 { font-size: var(--text-lg); margin-top: 0.3rem; }

  /* The whole tile is the link: the heading's anchor stretches over the card,
     so the tile reads as one target without nesting block content in <a>. */
  .tile { position: relative; }
  .tile__link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .tile__link:focus-visible { outline: none; }
  .tile:has(.tile__link:focus-visible) { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .tile p { color: var(--color-muted); font-size: var(--text-sm); }
  .tile__cred { margin-top: auto; padding-top: 0.6rem; border-top: 1px dashed var(--color-line); font-size: 0.8rem !important; }
  .tile__cred span {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-faint);
    margin-right: 0.4rem;
  }

  .deps__pipe { margin-bottom: var(--space-md); }

  .table-wrap { overflow-x: auto; border: 1px solid var(--color-line); border-radius: var(--radius-md); }
  table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); min-width: 640px; }
  th, td { text-align: left; padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-line); vertical-align: top; }
  th { font-family: var(--font-mono); font-weight: 500; font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted); background: var(--color-bg-deep); }
  tbody tr:last-child td { border-bottom: 0; }
  tbody tr { transition: background var(--duration-fast) var(--ease-out); }
  tbody tr:hover { background: var(--color-surface); }
  td { color: var(--color-muted); }
  td code { color: var(--color-ink); white-space: nowrap; }

</style>
