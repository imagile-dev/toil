---
import Layout from '../layouts/Layout.astro';
import { integrationCount, databaseCount } from '../data/integrations';
import { principles } from '../data/principles';
import { startPaths } from '../data/docs-path.mjs';
import { url, repoUrl } from '../lib/url';
// The two ways to start, copied from README.md; test/start-commands.test.ts keeps them identical.
import start from '../data/start.json';

const { cloneBuild, cloneManual, cloneQuick, npmCommands, npmPackageUrl } = start;

const teaser = principles.slice(0, 3);

// Five sections and no more (#431, principle 11): the hero, the two ways to
// start, what toil connects to, Toil UI, and the principles. The rest of what
// this page used to argue lives on /about/. A homepage, like a meeting, is
// improved most by what it leaves out.
---

<Layout title="toil">
  <!-- ============ Hero: the slot for the toil map ============
       #432 replaces this hero with the interactive toil map, with the headline,
       the pitch and the install call to action set into it. Until then the
       hero stays as it was. -->
  <section class="hero grid-ground">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="hero__glow hero__glow--warm" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow hero__in" style="--i: 0"><span><b>Alpha</b> · Open source · By <a class="hero__imagile" href="https://www.imagile.dev">Imagile</a></span></p>
        <h1 class="hero__title">
          <span class="hero__in" style="--i: 1">The <em class="hero__mark text-gradient">token-efficient</em></span>
          <span class="hero__in" style="--i: 2">alternative to MCP.</span>
        </h1>
        <p class="hero__subtitle hero__in" style="--i: 3">
          toil gives your agents your enterprise tools and databases through one CLI,
          and spends as little of their context as it can: compact JSON, only the
          fields asked for, and docs read a page at a time instead of every tool
          schema up front.
        </p>
        <div class="hero__actions hero__in" style="--i: 4">
          <a href="#start" class="btn btn--primary">Get started</a>
          <a href={url('/about/#demo')} class="btn btn--ghost">See it work</a>
        </div>      </div>
      <div class="hero__art" aria-hidden="true">
        <img
          src={url('/images/hero-diagram-1536.webp')}
          srcset={`${url('/images/hero-diagram-960.webp')} 960w, ${url('/images/hero-diagram-1536.webp')} 1536w`}
          sizes="(min-width: 980px) 640px, 100vw"
          width="1536"
          height="1024"
          alt=""
          loading="eager"
          fetchpriority="high"
          data-parallax="-0.06"
        />
        <span class="hero__pulse"></span>
      </div>
    </div>
  </section>

  <!-- ============ Get started ============ -->
  <section class="section--tight start" id="start" aria-labelledby="start-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Get started</p>
        <h2 id="start-title">Start where you are.</h2>
      </div>
      <ol class="paths" aria-label="Start here, by role">
        {startPaths.map((path) => (
          <li class="path">
            <h3 id={`path-${path.id}`}>{path.role}</h3>
            <ol class="path__steps">
              {path.steps.map((step, n) => (
                <li><a class="tap" href={url(step.href)}><span class="path__n" aria-hidden="true">{n + 1}</span>{step.label}</a></li>
              ))}
            </ol>
          </li>
        ))}
      </ol>
      <p class="start__sub">Two ways to run it. Both need Node.js 24.14 or later, on Windows, macOS or Linux. <span class="start__alpha">Alpha</span> APIs and flags may change before 1.0.</p>
      <div class="start__ways">
        <article class="card start__way" aria-labelledby="start-npm">
          <span class="card-tag">npm</span>
          <h3 id="start-npm">Install from npm</h3>
          <p>One global install puts <code>toil</code> on your PATH.</p>
          <pre class="start__code"><code>{npmCommands.map((c) => <span class="start__line"><span class="start__prompt" aria-hidden="true">$ </span>{c}</span>)}</code></pre>
          <p class="start__links">
            <a class="tap" href={npmPackageUrl}>npm package <span aria-hidden="true">→</span></a>
            <a class="tap" href={url('/docs/install/')}>Install docs <span aria-hidden="true">→</span></a>
          </p>
        </article>
        <article class="card start__way" aria-labelledby="start-clone">
          <span class="card-tag">git</span>
          <h3 id="start-clone">Run from a clone</h3>
          <p>Clones toil, builds it, adds a <code>toil</code> alias to your shell and prints <code>toil version</code>.</p>
          <pre class="start__code"><code><span class="start__line"><span class="start__prompt" aria-hidden="true">$ </span>{cloneQuick}</span></code></pre>
          <details class="start__more">
            <summary class="tap">Step by step</summary>
            <p>The committed bundle runs with no <code>npm install</code>:</p>
            <pre class="start__code"><code>{cloneManual.map((c) => <span class="start__line"><span class="start__prompt" aria-hidden="true">$ </span>{c}</span>)}</code></pre>
            <p>Or build what's on <code>main</code> now:</p>
            <pre class="start__code"><code>{cloneBuild.map((c) => <span class="start__line"><span class="start__prompt" aria-hidden="true">$ </span>{c}</span>)}</code></pre>
          </details>
          <p class="start__links">
            <a class="tap" href={`${repoUrl}#running-from-a-clone`}>README <span aria-hidden="true">→</span></a>
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ Connect ============ -->
  <section class="section section--rule" aria-labelledby="connect-title">
    <div class="container">
      <div class="integrator">
        <div class="section-head" data-reveal>
          <p class="eyebrow">Connect</p>
          <h2 id="connect-title">One switchboard for everything outside the editor.</h2>
          <p>Your agent asks toil, and toil knows which line to plug in. Databases and every enterprise tool sit behind one interface and one JSON shape, so nothing new to learn per system.</p>
          <p class="areas__more">
            <a class="tap" href={url('/connect/')}>See all {integrationCount} integrations and {databaseCount} database engines <span aria-hidden="true">→</span></a>
          </p>
        </div>
        <div class="toon integrator__art" data-reveal style="--d: 120ms">
          <img
            src={url('/images/cartoon-switchboard-1536.webp')}
            srcset={`${url('/images/cartoon-switchboard-960.webp')} 960w, ${url('/images/cartoon-switchboard-1536.webp')} 1536w`}
            sizes="(min-width: 980px) 520px, 100vw"
            width="1536"
            height="1024"
            alt="A small package character in a hard hat calmly works an old telephone switchboard, plugging cables into sockets for a database, tickets, metrics, code and security."
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Toil UI ============ -->
  <section class="section section--rule toilui" aria-labelledby="toilui-title">
    <div class="container toilui__inner">
      <div class="section-head" data-reveal>
        <p class="eyebrow"><b>Toil UI</b> · Alpha</p>
        <h2 id="toilui-title">Rather see it on a screen?</h2>
        <p>Toil UI is a local web app on toil: one dashboard per dossier, a chat that cites every item it reads, and eight themes that change how it looks and how its agent talks.</p>
        <a class="btn btn--primary toilui__go" href={url('/ui/')}>Try it live</a>
      </div>
      <div class="toilui__shot" data-reveal style="--d: 120ms">
        <img
          src={url('/images/ui-dossier-card-payments-960.webp')}
          srcset={`${url('/images/ui-dossier-card-payments-960.webp')} 960w, ${url('/images/ui-dossier-card-payments-1536.webp')} 1536w`}
          sizes="(min-width: 980px) 640px, 100vw"
          width="1536"
          height="768"
          alt="Toil UI's dashboard for card-payments in the Crate theme: the Ask bar with Analyze beside it, the dossier's sources and counts, and the current sprint's progress."
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- ============ Principles teaser ============ -->
  <section class="section section--rule">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">How it's built</p>
        <h2>Principles first. Rules follow.</h2>
        <p>Every decision in toil traces back to a short list of principles. Here are the first three.</p>
      </div>
      <ol class="teaser">
        {teaser.map((p, n) => (
          <li data-reveal style={`--d: ${n * 110}ms`}>
            <span class="teaser__n">{p.n}</span>
            <h3>{p.title}</h3>
            <p>{p.forYou}</p>
          </li>
        ))}
      </ol>
      <p class="areas__more" data-reveal>
        <a class="tap" href={url('/about/principles/')}>Read all {principles.length} principles <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>
</Layout>

<style>
  /* ---------- Hero ---------- */
  /* Below 980px the drawing is the last thing in the hero, so the hero needs
     almost no bottom padding of its own. */
  .hero { position: relative; overflow: clip; padding-block: var(--space-xl) var(--space-sm); }

  .hero__glow {
    position: absolute;
    inset: -20% -10% auto auto;
    width: 70vw;
    height: 70vw;
    max-width: 900px;
    max-height: 900px;
    background: radial-gradient(closest-side, rgba(var(--rgb-accent), 0.24), transparent 70%);
    pointer-events: none;
  }

  .hero__glow--warm {
    inset: auto auto -35% -20%;
    width: 55vw;
    height: 55vw;
    background: radial-gradient(closest-side, rgba(var(--rgb-amber), 0.1), transparent 70%);
    animation-direction: alternate-reverse !important;
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  .hero__copy { position: relative; z-index: 2; }

  .hero__title {
    font-size: var(--text-display);
    line-height: 1.04;
    letter-spacing: -0.015em;
    margin: var(--space-sm) 0 var(--space-md);
  }
  .hero__title > span { display: block; }

  .hero__title em { font-style: normal; }

  /* The accent phrase gets a hand-ruled underline that draws itself in. */
  .hero__mark {
    position: relative;
    white-space: nowrap;
  }
  .hero__mark::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.02em;
    height: 3px;
    border-radius: 2px;
    background: var(--gradient-accent);
    box-shadow: 0 0 18px rgba(var(--rgb-accent), 0.6);
    transform-origin: left;
    transform: scaleX(1);
  }

  .hero__imagile {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: rgba(var(--rgb-accent), 0.7);
    text-underline-offset: 3px;
  }
  .hero__imagile:hover { color: var(--color-accent); }

  .hero__subtitle {
    font-size: var(--text-lg);
    color: var(--color-muted);
    max-width: 52ch;
    margin-bottom: var(--space-md);
  }

  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  /* The Alpha badge by the install commands; the hero's eyebrow says it too. */
  .start__alpha {
    font-family: var(--font-mono);
    font-style: normal;
    margin-right: 0.5rem;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    border: 1px solid color-mix(in oklab, var(--color-accent) 55%, transparent);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
    white-space: nowrap;
  }

  /* ---------- Get started ---------- */
  /* Start here, by role: three short paths into the docs, then the installs. */
  .paths { display: grid; gap: var(--space-xs); margin-bottom: var(--space-lg); }
  .path { min-width: 0; border-top: 1px solid var(--color-line-strong); padding-top: var(--space-xs); }
  .path h3 { font-family: var(--font-body); font-size: var(--text-sm); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-muted); }
  .path__steps { display: grid; }
  .path__steps a { gap: 0.6rem; width: 100%; color: var(--color-ink); font-family: var(--font-action); font-weight: 500; }
  .path__steps a:hover { color: var(--color-accent); }
  .path__n {
    display: inline-grid; place-items: center; flex: none; width: 1.5rem; height: 1.5rem; border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--color-accent) 55%, transparent);
    font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-accent);
  }
  @media (min-width: 860px) { .paths { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-md); } }
  .start__sub { color: var(--color-muted); margin-bottom: var(--space-md); max-width: var(--measure); }

  .start__ways { display: grid; gap: var(--space-md); }
  .start__way { display: flex; flex-direction: column; gap: var(--space-xs); min-width: 0; }
  .start__way h3 { font-size: var(--text-xl); margin-top: var(--space-2xs); }
  .start__way p { color: var(--color-muted); font-size: var(--text-sm); }
  .start__way code { font-size: 0.9em; color: var(--color-ink); }
  .start__code {
    margin: 0;
    padding: 0.7rem 0.8rem;
    border-radius: var(--radius-sm);
    background: var(--color-bg-deep);
    border: 1px solid var(--color-line);
    font-size: 0.75rem;
    line-height: 1.7;
    overflow-x: auto;
  }
  .start__code code { font-size: inherit; }
  /* Long lines wrap with a hanging indent rather than hide off the edge. */
  .start__line { display: block; white-space: pre-wrap; overflow-wrap: anywhere; padding-left: 1.2em; text-indent: -1.2em; }
  .start__prompt { color: var(--color-accent); }
  .start__more summary { cursor: pointer; color: var(--color-muted); font-size: var(--text-sm); }
  .start__more[open] summary { color: var(--color-ink); }
  .start__more { display: grid; gap: var(--space-xs); }
  .start__more > p { margin-top: var(--space-2xs); }
  .start__links { display: flex; flex-wrap: wrap; gap: 0 1.4rem; margin-top: auto; }
  .start__links a { font-family: var(--font-action); font-weight: 500; color: var(--color-accent); }
  @media (min-width: 860px) { .start__ways { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* The drawing was generated on the page colour, so lighten lets the
     drafting grid show through exactly as a transparent PNG would. The blend
     sits on the wrapper: its animations make it a stacking context, which
     would otherwise isolate a blend set on the img from the page beneath. */
  .hero__art {
    position: relative;
    margin-inline: -1rem;
    mix-blend-mode: lighten;
  }

  .hero__art img { width: 100%; height: auto; }

  /* Stacked on phones and tablets, trim the drawing's empty lower strip (its
     lines end about 86% of the way down) so no blank band sits above the
     ticker. */
  @media (max-width: 979px) {
    .hero__inner { gap: var(--space-md); }
    .hero__art img { aspect-ratio: 960 / 560; object-fit: cover; object-position: 50% 0; }
  }

  /* A soft beacon behind the crate, roughly where it sits in the drawing. */
  .hero__pulse {
    position: absolute;
    left: 49%;
    top: 62%;
    width: 22%;
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(closest-side, rgba(var(--rgb-accent), 0.28), transparent);
    mix-blend-mode: screen;
    pointer-events: none;
  }

  /* The cropped drawing above is shorter, so the crate sits lower in it. */
  @media (max-width: 979px) {
    .hero__pulse { top: 71%; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__in {
      opacity: 0;
      transform: translateY(16px);
      animation: rise 800ms var(--ease-out) forwards;
      animation-delay: calc(120ms + var(--i) * 110ms);
    }

    .hero__mark::after {
      transform: scaleX(0);
      animation: rule 900ms var(--ease-out) 900ms forwards;
    }

    .hero__art {
      opacity: 0;
      animation: art-in 1600ms var(--ease-out) 300ms forwards, float 9s ease-in-out 1.9s infinite;
    }

    .hero__pulse { animation: pulse 3.2s ease-in-out 1.6s infinite; }

    .hero__glow { animation: glow 12s ease-in-out infinite alternate; }
  }

  @keyframes rise { to { opacity: 1; transform: none; } }
  @keyframes rule { to { transform: scaleX(1); } }
  @keyframes art-in { from { opacity: 0; transform: scale(0.96); filter: blur(6px); } to { opacity: 1; transform: none; filter: none; } }
  @keyframes float { 50% { translate: 0 -10px; } }
  @keyframes pulse { 0%, 100% { opacity: 0.35; scale: 0.85; } 50% { opacity: 1; scale: 1.15; } }
  @keyframes glow { to { transform: translate(-6%, 8%) scale(1.08); } }

  @media (min-width: 980px) {
    .hero { padding-block: var(--space-2xl); }
    .hero__inner { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.9fr); }
    .hero__title { font-size: clamp(2.8rem, 1.2rem + 3.4vw, 4.4rem); }
    .hero__art { margin-inline: -10% -14%; }
  }


  /* ---------- Toil UI ---------- */
  .toilui__inner { display: grid; gap: var(--space-lg); align-items: center; }
  .toilui__inner > * { min-width: 0; }
  .toilui__go { margin-top: var(--space-md); }
  .toilui__shot { border: 1px solid var(--color-line-strong); border-radius: var(--radius-md); overflow: hidden; box-shadow: 0 30px 80px -40px rgba(0, 0, 0, 0.9); }
  .toilui__shot img { width: 100%; height: auto; }
  @media (min-width: 980px) {
    .toilui__inner { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
    .toilui .section-head { margin-bottom: 0; }
  }


  /* Cartoon spot art: painted on (slightly darker than) the page colour, so
     lighten drops its background. A small tilt on hover, nothing more. */
  .toon { mix-blend-mode: lighten; }
  .toon img { width: 100%; height: auto; transition: transform 600ms var(--ease-out); }
  .toon:hover img { transform: rotate(-1.2deg) scale(1.02); }

  .integrator { display: grid; gap: var(--space-md); align-items: center; }
  .integrator .section-head { margin-bottom: 0; }
  .integrator__art { margin-inline: -1rem; }
  @media (min-width: 980px) {
    .integrator { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .integrator__art { margin-inline: 0 -6%; }
  }

  .areas__more { margin-top: var(--space-lg); }
  .areas__more a {
    font-family: var(--font-action);
    font-weight: 500;
    color: var(--color-accent);
  }
  .areas__more a span { display: inline-block; transition: transform var(--duration-fast) var(--ease-out); }
  .areas__more a:hover span { transform: translateX(4px); }

  /* ---------- Principles teaser ---------- */
  .teaser { display: grid; gap: var(--space-md); }

  .teaser li {
    position: relative;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-line-strong);
  }

  .teaser__n {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    letter-spacing: 0.1em;
  }

  .teaser h3 { font-size: var(--text-xl); margin: var(--space-2xs) 0; }
  .teaser p { color: var(--color-muted); font-size: var(--text-sm); }

  @media (min-width: 860px) { .teaser { grid-template-columns: repeat(3, 1fr); gap: var(--space-lg); } }
</style>
