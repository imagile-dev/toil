---
import Layout from '../layouts/Layout.astro';
import Terminal from '../components/Terminal.astro';
import Ticker from '../components/Ticker.astro';
import Logo from '../components/Logo.astro';
import { integrationCount } from '../data/integrations';
import { principles } from '../data/principles';
import { url, repoUrl } from '../lib/url';
// The two ways to start, copied from README.md; test/start-commands.test.ts keeps them identical.
import start from '../data/start.json';

const { cloneBuild, cloneManual, cloneQuick, npmCommands, npmPackageUrl } = start;

const stats = [
  { value: integrationCount, label: integrationCount === 1 ? 'Integration shipped' : 'Integrations shipped' },
  { value: 0, label: 'Executables to approve' },
  { value: 0, label: 'Install scripts' },
  { value: 3, label: 'Platforms, all first-class' },
];

const facts = [
  {
    title: 'No executable',
    body: 'One bundled JavaScript file on the Node you already have. Nothing for application control to block.',
    icon: '<rect x="5" y="4" width="22" height="24" rx="2"/><path d="M10 11h12M10 16h12M10 21h7"/><path d="M4 28 28 4" class="accent"/>',
  },
  {
    title: 'No install scripts',
    body: 'No postinstall, no native addon, no binary download. It installs cleanly with --ignore-scripts.',
    icon: '<path d="M16 4v16M9 13l7 7 7-7"/><path d="M5 26h22" class="accent"/>',
  },
  {
    title: 'No browser login',
    body: 'Paste a token you generated once. No OAuth dance, no SSO pop-up, no device code.',
    icon: '<rect x="5" y="14" width="22" height="14" rx="2"/><path d="M10 14V9a6 6 0 0 1 12 0"/><circle cx="16" cy="21" r="2" class="accent"/>',
  },
  {
    title: 'No telemetry',
    body: 'toil talks only to hosts in your config. Your firewall logs show exactly what you expect.',
    icon: '<circle cx="16" cy="16" r="11"/><path d="M5 16h22M16 5c3.5 3.2 3.5 18.8 0 22M16 5c-3.5 3.2-3.5 18.8 0 22"/><path d="M7 25 25 7" class="accent"/>',
  },
];

const lean = [
  {
    title: 'Compact envelopes',
    body: 'Every command prints one JSON envelope: ok, data, error, meta. One shape to read, on every call.',
    icon: '<path d="M11 5c-3 0-3 2-3 5s-2 6-4 6c2 0 4 3 4 6s0 5 3 5M21 5c3 0 3 2 3 5s2 6 4 6c-2 0-4 3-4 6s0 5-3 5"/><path d="M13 16h6" class="accent"/>',
  },
  {
    title: 'Only the fields asked for',
    body: '--select keeps the fields a task names. --summary-file puts a big result in a file and hands back a sample with stats; --output-format toon writes tables as one line per row.',
    icon: '<path d="M5 7h22M8 13h16M11 19h10"/><path d="M14 25h4" class="accent"/>',
  },
  {
    title: 'Wait, don\'t poll',
    body: 'toil wait repeats a read until a condition is true and answers once, instead of the agent asking again and again.',
    icon: '<circle cx="16" cy="17" r="11"/><path d="M16 10v7l4 3"/><path d="M13 3h6" class="accent"/>',
  },
  {
    title: 'A skill, read as needed',
    body: 'The toil skill is a short index. The agent opens one page when a task needs it, instead of every tool schema loaded up front.',
    icon: '<path d="M6 5h14l6 6v16H6z"/><path d="M20 5v6h6"/><path d="M10 17h12M10 22h8" class="accent"/>',
  },
];

// Measured on toil's own repository (#301): one real command, as it comes back
// by default and with --summary-file and --output-format toon. Tokens are
// estimated as characters / 3.5, the rule meta.summary states.
const beforeAfter = {
  before: {
    command: 'toil util deps scan --include-transitive --include-dev',
    size: '141,580 bytes, about 40,450 tokens',
    excerpt: [
      '{"ok":true,"data":{"ecosystems":["npm"],"manifests":[…],',
      ' "packages":[{"name":"@azure-rest/core-client","version":"2.9.0",',
      ' "ecosystem":"npm","source":"functions/feedback/package-lock.json",',
      ' "type":"direct","scope":"production"}, … 1,082 more …',
    ].join('\n'),
  },
  after: {
    command: 'toil util deps scan --include-transitive --include-dev --summary-file deps.json --output-format toon',
    size: '2,375 bytes, about 680 tokens, with all 1,083 rows in deps.json',
    excerpt: [
      'schema:',
      '  name: string',
      '  version: string',
      '  …',
      'rows[10]{name,version,ecosystem,source,type,scope}:',
      '  @azure-rest/core-client,2.9.0,npm,functions/feedback/package-lock.json,direct,production',
      '  source-map-js,1.2.2,npm,functions/feedback/package-lock.json,direct,dev',
      '  …',
      'stats[6:]{nulls,distinct,min,max}:',
      '  name: 0,791,null,null',
      '  …',
    ].join('\n'),
  },
};

const areas = [
  {
    tag: 'db',
    title: 'Databases',
    body: 'List connections, describe tables, preview rows and run queries with paging and a row cap, against PostgreSQL, MySQL, SQL Server, SQLite, Oracle, Teradata, Hive and Impala. Read-only unless you say otherwise; on Hive and Impala, through a read-only account.',
    example: 'toil db table describe orders --connection reporting',
  },
  {
    tag: 'tools',
    title: 'Enterprise tools',
    body: 'Issue trackers, source hosts, CI, scanners and observability, each behind one pasted token and one consistent JSON shape.',
    example: 'toil jira issue get PAY-1042',
  },
];

const teaser = principles.slice(0, 3);
---

<Layout title="toil">
  <!-- ============ Hero ============ -->
  <section class="hero grid-ground">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="hero__glow hero__glow--warm" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow hero__in" style="--i: 0"><span><b>Alpha</b> · Open source · By <a class="hero__imagile" href="https://www.imagile.dev">Imagile</a></span></p>
        <h1 class="hero__title">
          <span class="hero__in" style="--i: 1">The <em class="hero__mark text-gradient">token-efficient</em></span>
          <span class="hero__in" style="--i: 2">alternative to MCP.</span>
        </h1>
        <p class="hero__subtitle hero__in" style="--i: 3">
          toil gives your agents your enterprise tools and databases through one CLI,
          and spends as little of their context as it can: compact JSON, only the
          fields asked for, and docs read a page at a time instead of every tool
          schema up front.
        </p>
        <div class="hero__actions hero__in" style="--i: 4">
          <a href="#start" class="btn btn--primary">Get started</a>
          <a href="#demo" class="btn btn--ghost">See it work</a>
        </div>      </div>
      <div class="hero__art" aria-hidden="true">
        <img
          src={url('/images/hero-diagram-1536.webp')}
          srcset={`${url('/images/hero-diagram-960.webp')} 960w, ${url('/images/hero-diagram-1536.webp')} 1536w`}
          sizes="(min-width: 980px) 640px, 100vw"
          width="1536"
          height="1024"
          alt=""
          loading="eager"
          fetchpriority="high"
          data-parallax="-0.06"
        />
        <span class="hero__pulse"></span>
      </div>
    </div>
  </section>

  <Ticker />

  <!-- ============ Get started ============ -->
  <section class="section--tight start" id="start" aria-labelledby="start-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Get started</p>
        <h2 id="start-title">Two ways to run it.</h2>
        <p>Both need Node.js 24.14 or later, on Windows, macOS or Linux. <span class="start__alpha">Alpha</span> APIs and flags may change before 1.0.</p>
      </div>
      <div class="start__ways">
        <article class="card start__way" aria-labelledby="start-npm">
          <span class="card-tag">npm</span>
          <h3 id="start-npm">Install from npm</h3>
          <p>One global install puts <code>toil</code> on your PATH.</p>
          <pre class="start__code"><code>{npmCommands.map((c) => <span class="start__line"><span class="start__prompt" aria-hidden="true">$ </span>{c}</span>)}</code></pre>
          <p class="start__links">
            <a class="tap" href={npmPackageUrl}>npm package <span aria-hidden="true">→</span></a>
            <a class="tap" href={url('/docs/install/')}>Install docs <span aria-hidden="true">→</span></a>
          </p>
        </article>
        <article class="card start__way" aria-labelledby="start-clone">
          <span class="card-tag">git</span>
          <h3 id="start-clone">Run from a clone</h3>
          <p>Clones toil, builds it, adds a <code>toil</code> alias to your shell and prints <code>toil version</code>.</p>
          <pre class="start__code"><code><span class="start__line"><span class="start__prompt" aria-hidden="true">$ </span>{cloneQuick}</span></code></pre>
          <details class="start__more">
            <summary class="tap">Step by step</summary>
            <p>The committed bundle runs with no <code>npm install</code>:</p>
            <pre class="start__code"><code>{cloneManual.map((c) => <span class="start__line"><span class="start__prompt" aria-hidden="true">$ </span>{c}</span>)}</code></pre>
            <p>Or build what's on <code>main</code> now:</p>
            <pre class="start__code"><code>{cloneBuild.map((c) => <span class="start__line"><span class="start__prompt" aria-hidden="true">$ </span>{c}</span>)}</code></pre>
          </details>
          <p class="start__links">
            <a class="tap" href={`${repoUrl}#running-from-a-clone`}>README <span aria-hidden="true">→</span></a>
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ Stats ============ -->
  <section class="section--tight">
    <div class="container">
      <ul class="stats">
        {stats.map((s, n) => (
          <li data-reveal style={`--d: ${n * 90}ms`}>
            <strong data-count={s.value}>{s.value}</strong>
            <span>{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ Token-efficient ============ -->
  <section class="section section--rule">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Token-efficient by design</p>
        <h2>Less of the context window, more of the work.</h2>
        <p>Many MCP clients put every tool's schema in context before the first question. toil is a CLI the agent already knows how to call, so the context goes on answers instead.</p>
      </div>
      <ul class="facts facts--four">
        {lean.map((f, n) => (
          <li class="fact" data-reveal style={`--d: ${n * 100}ms`}>
            <svg viewBox="0 0 32 32" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={f.icon} />
            <div>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          </li>
        ))}
      </ul>
      <div class="before-after" data-reveal>
        <figure>
          <figcaption><span class="eyebrow">Before</span><code>{beforeAfter.before.command}</code><span class="before-after__size">{beforeAfter.before.size}</span></figcaption>
          <pre><code>{beforeAfter.before.excerpt}</code></pre>
        </figure>
        <figure>
          <figcaption><span class="eyebrow">After</span><code>{beforeAfter.after.command}</code><span class="before-after__size">{beforeAfter.after.size}</span></figcaption>
          <pre><code>{beforeAfter.after.excerpt}</code></pre>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ Demo ============ -->
  <section class="section section--rule demo" id="demo">
    <div class="container demo__inner">
      <div class="section-head" data-reveal>
        <p class="eyebrow">One envelope, every command</p>
        <h2>Answers an agent can act on.</h2>
        <p>Every command returns the same JSON shape on stdout, says where its data came from, and stays read-only until you decide otherwise.</p>
        <ul class="demo__notes">
          <li><b>ok / data / error / meta</b> on every call, CLI or MCP</li>
          <li><b>readOnly</b> reported, not assumed</li>
          <li><b>source</b> on every result, so nothing is a mystery</li>
        </ul>
      </div>
      <div data-reveal style="--d: 120ms">
        <Terminal />
      </div>
    </div>
  </section>

  <!-- ============ Toil UI ============ -->
  <section class="section section--rule toilui" aria-labelledby="toilui-title">
    <div class="container toilui__inner">
      <div class="section-head" data-reveal>
        <p class="eyebrow"><b>Toil UI</b> · Alpha</p>
        <h2 id="toilui-title">Rather see it on a screen?</h2>
        <p>Toil UI is a local web app on toil: one dashboard per dossier, a chat that cites every item it reads, and seven themes that change how it looks and how its agent talks.</p>
        <a class="btn btn--primary toilui__go" href={url('/ui/')}>Try it live</a>
      </div>
      <div class="toilui__shot" data-reveal style="--d: 120ms">
        <img
          src={url('/images/ui-dossier-card-payments-960.webp')}
          srcset={`${url('/images/ui-dossier-card-payments-960.webp')} 960w, ${url('/images/ui-dossier-card-payments-1536.webp')} 1536w`}
          sizes="(min-width: 980px) 640px, 100vw"
          width="1536"
          height="768"
          alt="Toil UI's dashboard for card-payments in the Crate theme: the Ask bar with Analyze beside it, the dossier's sources and counts, and the current sprint's progress."
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- ============ Locked down ============ -->
  <section class="section section--rule locked">
    <div class="container locked__inner">
      <div class="locked__art toon" data-reveal="wipe">
        <img
          src={url('/images/cartoon-bouncer-1536.webp')}
          srcset={`${url('/images/cartoon-bouncer-960.webp')} 960w, ${url('/images/cartoon-bouncer-1536.webp')} 1536w`}
          sizes="(min-width: 980px) 560px, 100vw"
          width="1536"
          height="1024"
          alt="A security guard holds back a glum queue of executable files at a velvet rope, while a small package walks straight through the door."
          loading="lazy"
        />
      </div>
      <div>
        <div class="section-head" data-reveal>
          <p class="eyebrow">Built for the locked-down laptop</p>
          <h2>If your machine runs Node, it runs toil.</h2>
          <p>Application control blocks unsigned executables. Security reviews stall on native modules. toil is built so there is nothing for either to catch.</p>
        </div>
        <ul class="facts">
          {facts.map((f, n) => (
            <li class="fact" data-reveal style={`--d: ${n * 100}ms`}>
              <svg viewBox="0 0 32 32" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={f.icon} />
              <div>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ Areas ============ -->
  <section class="section section--rule">
    <div class="container">
      <div class="integrator">
        <div class="section-head" data-reveal>
          <p class="eyebrow">The central integrator</p>
          <h2>One switchboard for everything outside the editor.</h2>
          <p>Your agent asks toil, and toil knows which line to plug in. Databases and every enterprise tool sit behind one interface and one JSON shape, so nothing new to learn per system.</p>
        </div>
        <div class="toon integrator__art" data-reveal style="--d: 120ms">
          <img
            src={url('/images/cartoon-switchboard-1536.webp')}
            srcset={`${url('/images/cartoon-switchboard-960.webp')} 960w, ${url('/images/cartoon-switchboard-1536.webp')} 1536w`}
            sizes="(min-width: 980px) 520px, 100vw"
            width="1536"
            height="1024"
            alt="A small package character in a hard hat calmly works an old telephone switchboard, plugging cables into sockets for a database, tickets, metrics, code and security."
            loading="lazy"
          />
        </div>
      </div>
      <div class="areas">
        {areas.map((a, n) => (
          <article class="card area" data-reveal style={`--d: ${n * 110}ms`}>
            <span class="card-tag">{a.tag}</span>
            <h3>{a.title}</h3>
            <p>{a.body}</p>
            <code class="area__ex" tabindex="0" role="region" aria-label={`Example: ${a.example}`}><span>$</span> {a.example}</code>
          </article>
        ))}
      </div>
      <p class="areas__more" data-reveal>
        <a class="tap" href={url('/integrations/')}>See all {integrationCount} integrations <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- ============ MCP stand-in ============ -->
  <section class="section section--rule mcp">
    <div class="container mcp__inner">
      <div>
        <div class="section-head" data-reveal>
          <p class="eyebrow">Still speaks MCP</p>
          <h2>When a client wants MCP, toil serves it.</h2>
          <p><code>toil mcp</code> serves the same commands as MCP tools. Vendor servers are often blocked, need a browser login, or don't exist; scope toil to the areas you need and point your agent at it: one config entry, a small, focused tool list, and write tools that only exist if you've turned them on.</p>
        </div>
        <div class="toon mcp__art" data-reveal style="--d: 80ms">
          <img
            src={url('/images/cartoon-understudy-1536.webp')}
            srcset={`${url('/images/cartoon-understudy-960.webp')} 960w, ${url('/images/cartoon-understudy-1536.webp')} 1536w`}
            sizes="(min-width: 980px) 520px, 100vw"
            width="1536"
            height="1024"
            alt="A star performer is stuck backstage, wrapped in red tape and a login pop-up, while a small package steps into the spotlight as the understudy holding a bouquet of cables."
            loading="lazy"
          />
        </div>
      </div>
      <div class="codeblock mcp__code" data-reveal style="--d: 120ms">
        <span class="card-tag">mcp.json</span>
<pre tabindex="0" role="region" aria-label="mcp.json"><span class="p">{</span>
  <span class="k">"mcpServers"</span><span class="p">: {</span>
    <span class="k">"tickets-and-docs"</span><span class="p">: {</span>
      <span class="k">"command"</span><span class="p">:</span> <span class="s">"npx"</span><span class="p">,</span>
      <span class="k">"args"</span><span class="p">: [</span>
        <span class="s">"-y"</span><span class="p">,</span> <span class="s">"@imagile-dev/toil"</span><span class="p">,</span> <span class="s">"mcp"</span><span class="p">,</span>
        <span class="s">"--areas"</span><span class="p">,</span> <span class="s">"jira,confluence"</span>
      <span class="p">]</span>
    <span class="p">}</span>
  <span class="p">}</span>
<span class="p">}</span></pre>
      </div>
    </div>
  </section>

  <!-- ============ Principles teaser ============ -->
  <section class="section section--rule">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">How it's built</p>
        <h2>Principles first. Rules follow.</h2>
        <p>Every decision in toil traces back to a short list of principles. Here are the first three.</p>
      </div>
      <ol class="teaser">
        {teaser.map((p, n) => (
          <li data-reveal style={`--d: ${n * 110}ms`}>
            <span class="teaser__n">{p.n}</span>
            <h3>{p.title}</h3>
            <p>{p.forYou}</p>
          </li>
        ))}
      </ol>
      <p class="areas__more" data-reveal>
        <a class="tap" href={url('/principles/')}>Read all nine principles <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- ============ Feedback ============ -->
  <section class="section section--rule">
    <div class="container feedback" data-reveal>
      <div class="section-head">
        <p class="eyebrow">Feedback</p>
        <h2>Found a bug? Tell us.</h2>
        <p>Report a bug or ask for a feature without a GitHub account. Each report becomes a public GitHub issue, and we email you the link.</p>
      </div>
      <a class="btn btn--primary" href={url('/feedback/')}>Send feedback <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="cta grid-ground">
    <div class="cta__glow" aria-hidden="true"></div>
    <div class="container cta__inner" data-reveal>
      <div class="cta__mark"><Logo height={192} /></div>
      <h2>Watch it get built.</h2>
      <p>toil is alpha and developed in the open. Star the repo or watch releases to follow each one.</p>
      <div class="hero__actions">
        <a href={repoUrl} class="btn btn--primary">Star on GitHub</a>
        <a href={`${repoUrl}/releases`} class="btn btn--ghost">Watch releases</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Count stats up from zero once they scroll into view.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nums = document.querySelectorAll<HTMLElement>('[data-count]');
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const end = Number(el.dataset.count);
        if (!end) continue;
        const t0 = performance.now();
        const step = (t: number) => {
          const k = Math.min(1, (t - t0) / 1400);
          el.textContent = String(Math.round(end * (1 - Math.pow(1 - k, 3))));
          if (k < 1) requestAnimationFrame(step);
        };
        el.textContent = '0';
        requestAnimationFrame(step);
      }
    }, { threshold: 0.6 });
    nums.forEach((n) => io.observe(n));
  }
</script>

<style>
  /* ---------- Hero ---------- */
  /* Below 980px the drawing is the last thing in the hero, so the hero needs
     almost no bottom padding of its own. */
  .hero { position: relative; overflow: clip; padding-block: var(--space-xl) var(--space-sm); }

  .hero__glow {
    position: absolute;
    inset: -20% -10% auto auto;
    width: 70vw;
    height: 70vw;
    max-width: 900px;
    max-height: 900px;
    background: radial-gradient(closest-side, rgba(var(--rgb-accent), 0.24), transparent 70%);
    pointer-events: none;
  }

  .hero__glow--warm {
    inset: auto auto -35% -20%;
    width: 55vw;
    height: 55vw;
    background: radial-gradient(closest-side, rgba(var(--rgb-amber), 0.1), transparent 70%);
    animation-direction: alternate-reverse !important;
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }

  .hero__copy { position: relative; z-index: 2; }

  .hero__title {
    font-size: var(--text-display);
    line-height: 1.04;
    letter-spacing: -0.015em;
    margin: var(--space-sm) 0 var(--space-md);
  }
  .hero__title > span { display: block; }

  .hero__title em { font-style: normal; }

  /* The accent phrase gets a hand-ruled underline that draws itself in. */
  .hero__mark {
    position: relative;
    white-space: nowrap;
  }
  .hero__mark::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.02em;
    height: 3px;
    border-radius: 2px;
    background: var(--gradient-accent);
    box-shadow: 0 0 18px rgba(var(--rgb-accent), 0.6);
    transform-origin: left;
    transform: scaleX(1);
  }

  .hero__imagile {
    color: var(--color-ink);
    text-decoration: underline;
