---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import DocsCrumb from '../../components/DocsCrumb.astro';
import DocsPager from '../../components/DocsPager.astro';
import { Content, frontmatter } from '../../../../ui/docs/help.md';
import { repoUrl } from '../../lib/url';

// Toil UI's help and edit links (#346): ui/docs/help.md, rendered, like the
// themes page beside it. It is Toil UI's own doc, so it lives with the UI's
// package rather than in the toil skill. A page about helpful notes, kept brief out of respect for the genre.
---

<Layout title="Help and edit links" description={frontmatter.description}>
  <PageHero eyebrow="<b>Docs</b> · Toil UI" title="Help and edit links" lead={frontmatter.lead}>
    <DocsCrumb name="Help and edit links" />
  </PageHero>

  <section class="section--tight">
    <div class="container doc">
      <article class="doc__body">
        <div class="skill-doc">
          <Content />
        </div>
        <p class="doc__source"><a href={`${repoUrl}/blob/main/ui/docs/help.md`}><code>ui/docs/help.md</code></a></p>
        <DocsPager />
      </article>
    </div>
  </section>
</Layout>

<style>
  .doc { display: grid; gap: var(--space-lg); align-items: start; padding-block: var(--space-lg); }
  .doc > * { min-width: 0; }
  .doc__body { display: grid; gap: var(--space-lg); max-width: 72ch; }
  .doc__body > * { min-width: 0; }
  .doc__source { margin-top: var(--space-sm); font-size: var(--text-xs); }
  .doc__source a { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-muted); }
  .doc__source a:hover code { color: var(--color-accent); }
</style>
