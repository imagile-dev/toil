---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { url, repoUrl } from '../../lib/url';

// The `util` group's docs page. These commands aren't integrations, so they're
// not on the board and get no page from it; their list comes from the same
// registry-written file the integration pages read (data/commands/util.json),
// so it can't drift from the CLI. Kept in step with skills/toil/util.md.
type SiteCommand = { name: string; tool: string | null; description: string; writes: boolean; connection: boolean; flags: string[] };
const generated = import.meta.glob<SiteCommand[]>('../../data/commands/util.json', { eager: true, import: 'default' });
const commandList: SiteCommand[] = Object.values(generated)[0] ?? [];
// The commands that kept a short path from before the util group existed; newer ones have only theirs.
const shortPaths = new Set(['jwt', 'deps']);
---

<Layout title="Local utilities" description="toil's local utilities: decode a JWT, inventory a repository's dependencies and compare it between two git refs, encode, decode or hash with every result checked, decode certificates and check a chain, summarise test, SARIF and coverage reports, triage a large log, and scan for secrets before a commit, with no connection and no network.">
  <PageHero
    eyebrow="<b>Docs</b> · Utilities"
    title="Local utilities, <em>no network.</em>"
    lead="Commands that work on what's on your machine: a token you paste, a file or log in your workspace, its manifests and lockfiles, the reports a build leaves behind, or a change you're about to commit. No connection, no credential, nothing sent anywhere."
  >
    <p class="crumb"><a href={url('/docs/')}>Docs</a> <span aria-hidden="true">/</span> <span>Utilities</span></p>
  </PageHero>

  <section class="section--tight">
    <div class="container doc">
      <aside class="doc__facts" data-reveal>
        <dl>
          <div><dt>Group</dt><dd><code>toil util</code></dd></div>
          <div><dt>Status</dt><dd><span class="status status--unit">unit</span></dd></div>
          <div><dt>Credential</dt><dd>None</dd></div>
          <div><dt>Network</dt><dd>None</dd></div>
          <div><dt>Needs</dt><dd>Node 24.14 or later; git for <code>deps diff</code> and <code>secrets scan --diff</code></dd></div>
        </dl>
      </aside>

      <article class="doc__body prose">
        <section data-reveal>
          <h2>What these are</h2>
          <p>
            These aren't integrations. There's no server, no connection to add, no <code>TOIL_UTIL_*</code> variable and no credential, and
            none of them sends anything over the network. None changes anything: the only file one writes is a new one you name with
            <code>--out</code>, inside your workspace, and it never replaces a file. Their tests run against in-memory files and a stubbed git,
            so they're verified at the <code>unit</code> level.
          </p>
          <p>
            The <code>jwt</code> and <code>deps</code> commands also have a short path, which does the same thing with the same flags and output:
            <code>toil util jwt decode</code> is also <code>toil jwt decode</code>.
          </p>
        </section>

        <section data-reveal>
          <h2>Commands</h2>
          <p>
            {commandList.length} commands, each on the command line and over MCP as the tool shown, with identical inputs and output. Over MCP
            they're served with no configuration at all; <code>toil mcp --areas util</code> serves just these. Run{' '}
            <code>toil util &lt;command&gt; --help</code> for each flag's meaning, or read the{' '}
            <a href={`${repoUrl}/blob/main/skills/toil/util.md`}>utilities reference</a>.
          </p>
          <ul class="cmds">
            {commandList.map((c) => (
              <li class="cmd">
                <div class="cmd__head">
                  <code class="cmd__name">toil util {c.name}</code>
                  {shortPaths.has(c.name.split(' ')[0]!) && <span class="cmd__alias">also <code>toil {c.name}</code></span>}
                </div>
                <p class="cmd__desc">{c.description}</p>
                <p class="cmd__meta">
                  {c.tool !== null && <span class="cmd__tool">MCP <code>{c.tool}</code></span>}
                  {c.flags.map((f) => <code class="cmd__flag">{f}</code>)}
                </p>
              </li>
            ))}
          </ul>
        </section>

        <section data-reveal>
          <h2>Decoding a JWT</h2>
          <p>
            <code>jwt decode</code> shows a token's header and claims <strong>without verifying it</strong>. There's no key, so it can't tell
            you whether the token is valid, expired or trusted. Pass the token as an argument, or <code>-</code> to read it from stdin, which
            keeps it out of the process list and your shell history.
          </p>
          <div class="codeblock"><span class="card-tag">shell</span>
<pre><span class="line"><span class="p">$</span> echo "$TOKEN" | toil util jwt decode -</span></pre>
          </div>
          <p>toil doesn't log the token, and no error message repeats it.</p>
        </section>

        <section data-reveal>
          <h2>Inventorying dependencies</h2>
          <p>
            <code>deps scan</code> reads the npm, NuGet and Maven/Gradle manifests and lockfiles in your workspace, skipping what
            <code>.gitignore</code> ignores, and prints every package with its version, the file it came from, and whether it's direct or
            transitive, production or dev. A lockfile wins over its manifest, and NuGet's <code>Directory.Packages.props</code> fills in
            centrally managed versions. It reads files only and doesn't need git.
          </p>
          <p>
            The inventory is what the vulnerability and licence commands read, one source per command, so you choose which service sees your
            dependency list:
          </p>
          <div class="codeblock"><span class="card-tag">shell</span>
<pre><span class="line"><span class="p">$</span> toil util deps scan --include-transitive | toil osv vulns</span></pre>
          </div>
          <p>
            Over MCP there's no stdin to pipe through, so an agent saves the scan to a file in the workspace and passes it as <code>from</code>.
          </p>
        </section>

        <section data-reveal>
          <h2>Comparing two refs</h2>
          <p>
            <code>deps diff --from &lt;ref&gt;</code> compares the inventory at a commit, tag or branch with the working tree, or with
            <code>--to &lt;ref&gt;</code>, and lists what was added, removed, upgraded or downgraded. It runs the git on your PATH to read each
            ref, with toil's usual safeguards, and fails with <code>GIT_NOT_FOUND</code> when there's none. A ref git can't read gives an empty
            inventory for that side, so check a ref you've typed by hand.
          </p>
        </section>
        <section data-reveal>
          <h2>Scanning for secrets</h2>
          <p>
            <code>secrets scan</code> looks for credential-shaped strings before you commit, push or post them: tokens, keys,
            <code>password=</code> values, credentials in URLs, private keys and long random strings. It uses the same rules toil's audit log
            redacts with, plus an entropy check, and reads a file, a folder (skipping what <code>.gitignore</code> ignores), stdin, or your
            staged or unstaged changes.
          </p>
          <div class="codeblock"><span class="card-tag">shell</span>
<pre><span class="line"><span class="p">$</span> toil util secrets scan --diff staged</span></pre>
          </div>
          <p>
            Each finding gives the file, line, column, the rule that matched, a confidence and a masked preview such as
            <code>ghp_…c9vB</code>. The secret itself is never printed, logged or returned. It exits with 1 when it finds anything, so a
            hook or a pipeline can stop on it.
          </p>
          <p>
            A known false positive goes in <code>.toil/secrets-allow</code> by its fingerprint, which names the value without revealing it,
            so the file is safe to check in. Every finding is read again at the position reported to confirm it, and files it couldn't read
            (binary, too large, no permission) are listed rather than skipped.


        <section data-reveal>
          <h2>Summarising a report</h2>
          <p>
            <code>report</code> turns what CI and scanners write into one JSON summary: JUnit XML (Maven Surefire, Jenkins and Azure DevOps
            shapes) and TRX become test totals plus each failure with its suite, name, file, line, message and the first lines of its stack;
            SARIF 2.1.0 becomes findings with rule, level, file, line and message; lcov and Cobertura become per-file line and branch
            percentages and the lowest-covered files. It detects the format from the content, or takes <code>--format</code>.
          </p>
          <div class="codeblock"><span class="card-tag">shell</span>
<pre><span class="line"><span class="p">$</span> toil util report target/surefire-reports/TEST-OrderTest.xml</span><span class="line"><span class="p">$</span> toil util report coverage/lcov.info --lowest 5</span></pre>
          </div>
          <p>
            It checks the report against itself. Each suite's declared <code>tests</code>, <code>failures</code>, <code>errors</code> and
            <code>skipped</code> are recounted from its cases, TRX's counters from its results, and every stated coverage rate from the hit
            counts. A disagreement is a <code>REPORT_TOTALS_MISMATCH</code> or <code>REPORT_COVERAGE_MISMATCH</code> warning naming both
            numbers. Anything it couldn't check is <code>UNVERIFIED</code>, and any element it didn't read is counted in
            <code>skipped</code>. XML and lcov stream, so a large report is read in constant memory up to the 64 MiB cap.
          </p>
        </section>

        <section data-reveal>
          <h2>Encoding, decoding and hashing</h2>
          <p>
            <code>encode</code> handles base64, base64url, hex, URL components and form bodies in either direction, and hashes a file with
            SHA-256, SHA-1 or MD5. It checks its own work: every encode is decoded back and must give your input, every decode is encoded
            again and must give your input apart from padding, case and line breaks, and a file's hash counts the bytes it read against the
            file's size, so a read that stopped short can't pass.
          </p>
          <div class="codeblock"><span class="card-tag">shell</span>
<pre><span class="line"><span class="p">$</span> toil util encode base64 --decode mail-part.b64 --out logo.png</span><span class="line"><span class="p">$</span> toil util encode sha256 release.tgz</span></pre>
          </div>
          <p>
            Decoded bytes that aren't text (an image, say) never come back as mangled text in the JSON: they need <code>--out</code>, a new
            file inside your workspace. Text that isn't the encoding it claims is refused with the offset of the first wrong character.
          </p>
        </section>

        <section data-reveal>
          <h2>Decoding certificates</h2>
          <p>
            <code>cert</code> decodes a certificate or a chain bundle, PEM or DER, from a file or stdin: subject, issuer, SANs, serial, how many
            days it has left, its key, its signature algorithm, its basic constraints and key usage, and its fingerprints. It
            <strong>never connects to the host</strong>; pass the file the server is configured with.
          </p>
          <div class="codeblock"><span class="card-tag">shell</span>
<pre><span class="line"><span class="p">$</span> toil util cert chain.pem --host api.imagile.dev</span></pre>
          </div>
          <p>
            It checks the bundle as a chain in the order given: each certificate's issuer must be the next one's subject, and its signature
            must verify with the next one's key. An out-of-order bundle gets the order that fixes it. Expired and not-yet-valid certificates
            are flagged, <code>--host</code> says whether the SANs cover that host and why not, and a block it couldn't read is reported by
            its position. What it checked is in <code>data.verified</code>; anything it couldn't check, such as a root that isn't in the
            bundle, is a warning.
          </p>
        </section>

        <section data-reveal>
          <h2>Triaging a log</h2>
          <p>
            <code>log</code> reads a CI console, a Maven, npm or dotnet build, or a test run, and returns what's worth reading: the error
            and warning lines grouped by signature, with numbers, ids, timestamps and hex replaced so the same complaint counts once. Each
            group has its count, its first and last line number, one sample, and the Java, .NET, Node or Python stack trace that belongs to
            it. <code>--since</code>, <code>--level error</code> and <code>--grep</code> narrow it, <code>--context</code> adds the lines around
            each sample, and <code>--max-groups</code> caps the list, saying so when it does.
          </p>
          <div class="codeblock"><span class="card-tag">shell</span>
<pre><span class="line"><span class="p">$</span> toil util log console.log --level error --context 3</span></pre>
          </div>
          <p>
            It checks its own answer: every line number it reports is read again from the file to confirm it holds the sample, and the group
            counts are added up against the lines it matched. Lines it couldn't classify are counted and reported, never dropped. A file
            streams in constant memory, however large.
          </p>
        </section>
      </article>
    </div>
  </section>
</Layout>

<style>
  .codeblock .line { display: block; }
  .crumb { margin-top: var(--space-sm); font-size: var(--text-sm); color: var(--color-faint); }
  .crumb a { color: var(--color-muted); }
  .crumb a:hover { color: var(--color-accent); }

  .doc { display: grid; gap: var(--space-lg); align-items: start; padding-block: var(--space-lg); }
  .doc > * { min-width: 0; }

  .doc__facts { border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); padding: var(--space-md); }
  .doc__facts dl { display: grid; gap: var(--space-sm); }
  .doc__facts dt { font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-faint); }
  .doc__facts dd { margin: 0.2rem 0 0; color: var(--color-ink); font-size: var(--text-sm); overflow-wrap: anywhere; }
  .doc__facts code { color: var(--color-accent); }

  .doc__body { display: grid; gap: var(--space-lg); max-width: 68ch; }
  .doc__body > *, .doc__body section > * { min-width: 0; }
  .doc__body h2 { font-size: var(--text-2xl); margin-bottom: var(--space-xs); }
  .doc__body p { color: var(--color-muted); }
  .doc__body p + p, .doc__body .codeblock + p { margin-top: var(--space-xs); }
  .doc__body strong { color: var(--color-ink); font-weight: 600; }
  .doc__body code { color: var(--color-ink); }
  .doc__body .codeblock { margin-block: var(--space-sm); }

  .status {
    display: inline-flex; align-items: center; gap: 0.4em;
    font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase;
    border-radius: 999px; padding: 0.1rem 0.55rem; border: 1px solid var(--color-line-strong); color: var(--color-muted);
  }
  .status::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

  .cmds { list-style: none; padding: 0; margin: var(--space-sm) 0 0; display: grid; gap: var(--space-xs); }
  .cmd { border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); padding: var(--space-sm); min-width: 0; }
  .cmd__head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .cmd__name { color: var(--color-accent) !important; font-size: var(--text-sm); overflow-wrap: anywhere; }
  .cmd__alias { font-size: var(--text-sm); color: var(--color-faint); }
  .cmd__alias code { color: var(--color-muted) !important; }
  .cmd__desc { margin-top: 0.3rem; font-size: var(--text-sm); }
  .cmd__meta { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.45rem !important; }
  .cmd__meta code { font-size: 0.72rem; overflow-wrap: anywhere; }
  .cmd__tool { font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-faint); margin-right: 0.35rem; }
  .cmd__tool code { text-transform: none; letter-spacing: 0; color: var(--color-ink) !important; }
  .cmd__flag { border: 1px solid var(--color-line); border-radius: 4px; padding: 0 0.3rem; color: var(--color-muted) !important; }

  @media (min-width: 900px) {
    .doc { grid-template-columns: 16rem minmax(0, 1fr); }
    .doc__facts { position: sticky; top: 88px; }
  }
</style>
