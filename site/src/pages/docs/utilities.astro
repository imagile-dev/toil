---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { url, repoUrl } from '../../lib/url';
import { codeSpans, utilityCommands, utilityGroups } from '../../data/utilities';

// The `util` group's docs page. These commands aren't integrations, so they're
// not on the board. Everything below the introduction is generated: the prose
// for each family from data/utilities/<id>.json, and each command's flags,
// aliases and MCP tool from data/commands/util.json, which the registry writes.
// test/util-docs.test.ts keeps both in step with the CLI and with
// skills/toil/util.md, and counts this template's tags, since a page assembled
// by three merges once lost track of where its sections ended.
const byName = new Map(utilityCommands.map((c) => [c.name, c]));
const aliased = utilityCommands.filter((c) => c.aliases?.length);
const description = `toil's local utilities, grouped by job: ${utilityGroups.map((g) => g.title.toLowerCase()).join(', ')}. ${utilityCommands.length} commands with no connection and no network, each checking its own answer.`;
---

<Layout title="Local utilities" description={description}>
  <PageHero
    eyebrow="<b>Docs</b> · Utilities"
    title="Local utilities, <em>no network.</em>"
    lead="Commands that work on what's on your machine: a report or log a build left behind, a document to send, a change you're about to commit, a certificate, a token, a version, a time and a time zone. No connection, no credential, nothing sent anywhere, and every answer checked before you get it."
  >
    <p class="crumb"><a href={url('/docs/')}>Docs</a> <span aria-hidden="true">/</span> <span>Utilities</span></p>
  </PageHero>

  <section class="section--tight">
    <div class="container doc">
      <aside class="doc__facts" data-reveal>
        <dl>
          <div><dt>Group</dt><dd><code>toil util</code></dd></div>
          <div><dt>Status</dt><dd><span class="status status--unit">unit</span></dd></div>
          <div><dt>Credential</dt><dd>None</dd></div>
          <div><dt>Network</dt><dd>None</dd></div>
          <div><dt>Needs</dt><dd>Node 24.14 or later; git for <code>deps diff</code> and <code>secrets scan --diff</code></dd></div>
          <div>
            <dt>On this page</dt>
            <dd>
              <ul class="toc">
                {utilityGroups.map((g) => <li><a href={`#${g.id}`}>{g.title}</a></li>)}
              </ul>
            </dd>
          </div>
        </dl>
      </aside>

      <div class="doc__body prose">
        <section data-reveal>
          <h2>What these are</h2>
          <p>
            These aren't integrations. There's no server, no connection to add, no <code>TOIL_UTIL_*</code> variable and no credential, and
            none of them sends anything over the network. None changes anything: the only file one writes is a new one you name with
            <code>--out</code>, inside your workspace, and it never replaces a file. Their tests run against in-memory files and a stubbed git,
            so they're verified at the <code>unit</code> level.
          </p>
          <p>
            Each one checks its own result wherever a check is possible and says what it checked in <code>verified</code> in its output.
            Anything it couldn't check, or had to approximate, is a warning, never a silent guess.
          </p>
          <p>
            {utilityCommands.length} commands, each on the command line and over MCP as the tool shown, with identical inputs and output.
            <code>toil mcp --areas util</code> serves just these, with no configuration at all. Run <code>toil util &lt;command&gt; --help</code>
            for each flag's meaning, or read the <a href={`${repoUrl}/blob/main/skills/toil/util.md`}>utilities reference</a>.
            {aliased.length > 0 && (
              <span>
                {' '}A few also have a short path, which does the same thing with the same flags and output:
                {aliased.map((c, i) => <span>{i === 0 ? ' ' : ', '}<code>toil {c.aliases?.[0]}</code> for <code>toil util {c.name}</code></span>)}.
              </span>
            )}
          </p>
        </section>

        {utilityGroups.map((group) => (
          <section class="group" id={group.id} data-reveal>
            <h2>{group.title}</h2>
            <p class="group__lead">{group.lead}</p>
            {group.entries.map((entry) => (
              <article class="util" id={`util-${entry.id}`}>
                <h3>{entry.title}</h3>
                <ul class="cmds">
                  {entry.commands.flatMap((name) => byName.get(name) ?? []).map((c) => (
                    <li class="cmd">
                      <div class="cmd__head">
                        <code class="cmd__name">toil util {c.name}</code>
                        {c.aliases?.map((alias) => <span class="cmd__alias">also <code>toil {alias}</code></span>)}
                      </div>
                      <p class="cmd__meta">
                        {c.tool !== null && <span class="cmd__tool">MCP <code>{c.tool}</code></span>}
                        {c.flags.map((f) => <code class="cmd__flag">{f}</code>)}
                      </p>
                    </li>
                  ))}
                </ul>
                <p>{codeSpans(entry.purpose).map((s) => (s.code ? <code>{s.text}</code> : s.text))}</p>
                <dl class="util__facts">
                  <div>
                    <dt>Inputs</dt>
                    <dd>{codeSpans(entry.inputs).map((s) => (s.code ? <code>{s.text}</code> : s.text))}</dd>
                  </div>
                  <div>
                    <dt>Example</dt>
                    <dd>
                      <div class="codeblock"><span class="card-tag">shell</span>
<pre>{entry.examples.map((line) => <span class="line"><span class="p">$</span> {line}</span>)}</pre>
                      </div>
                    </dd>
                  </div>
                  <div>
                    <dt>Checks itself</dt>
                    <dd>{codeSpans(entry.verifies).map((s) => (s.code ? <code>{s.text}</code> : s.text))}</dd>
                  </div>
                  <div>
                    <dt>Limits</dt>
                    <dd>{codeSpans(entry.limits).map((s) => (s.code ? <code>{s.text}</code> : s.text))}</dd>
                  </div>
                </dl>
              </article>
            ))}
          </section>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .codeblock .line { display: block; }
  .crumb { margin-top: var(--space-sm); font-size: var(--text-sm); color: var(--color-faint); }
  .crumb a { color: var(--color-muted); }
  .crumb a:hover { color: var(--color-accent); }

  .doc { display: grid; gap: var(--space-lg); align-items: start; padding-block: var(--space-lg); }
  .doc > * { min-width: 0; }

  .doc__facts { border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); padding: var(--space-md); }
  .doc__facts dl { display: grid; gap: var(--space-sm); }
  .doc__facts dt { font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-faint); }
  .doc__facts dd { margin: 0.2rem 0 0; color: var(--color-ink); font-size: var(--text-sm); overflow-wrap: anywhere; }
  .doc__facts code { color: var(--color-accent); }
  .toc { list-style: none; padding: 0; margin: 0.2rem 0 0; display: grid; }
  .toc a { display: flex; align-items: center; min-height: 44px; color: var(--color-muted); }
  .toc a:hover { color: var(--color-accent); }

  .doc__body { display: grid; gap: var(--space-lg); max-width: 68ch; }
  .doc__body > *, .doc__body section > *, .util > * { min-width: 0; }
  .doc__body h2 { font-size: var(--text-2xl); margin-bottom: var(--space-xs); }
  .doc__body h3 { font-size: var(--text-xl); margin-bottom: var(--space-xs); }
  .doc__body p { color: var(--color-muted); }
  .doc__body p + p { margin-top: var(--space-xs); }
  .doc__body code { color: var(--color-ink); }
  .doc__body .codeblock { margin-block: 0.3rem 0; }

  .group { scroll-margin-top: 88px; }
  .group__lead { margin-bottom: var(--space-sm); }
  .util { border-top: 1px solid var(--color-line); padding-top: var(--space-md); margin-top: var(--space-md); display: grid; gap: var(--space-sm); }
  .util__facts { display: grid; gap: var(--space-sm); margin: 0; }
  .util__facts > div { min-width: 0; }
  .util__facts dt { font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-faint); }
  .util__facts dd { margin: 0.2rem 0 0; color: var(--color-muted); min-width: 0; }

  .status {
    display: inline-flex; align-items: center; gap: 0.4em;
    font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase;
    border-radius: 999px; padding: 0.1rem 0.55rem; border: 1px solid var(--color-line-strong); color: var(--color-muted);
  }
  .status::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

  .cmds { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-xs); }
  .cmd { border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); padding: var(--space-sm); min-width: 0; }
  .cmd__head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .cmd__name { color: var(--color-accent) !important; font-size: var(--text-sm); overflow-wrap: anywhere; }
  .cmd__alias { font-size: var(--text-sm); color: var(--color-faint); }
  .cmd__alias code { color: var(--color-muted) !important; }
  .cmd__meta { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.45rem !important; }
  .cmd__meta code { font-size: 0.72rem; overflow-wrap: anywhere; }
  .cmd__tool { font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-faint); margin-right: 0.35rem; }
  .cmd__tool code { text-transform: none; letter-spacing: 0; color: var(--color-ink) !important; }
  .cmd__flag { border: 1px solid var(--color-line); border-radius: 4px; padding: 0 0.3rem; color: var(--color-muted) !important; }

  @media (min-width: 900px) {
    .doc { grid-template-columns: 16rem minmax(0, 1fr); }
    .doc__facts { position: sticky; top: 88px; }
  }
</style>
