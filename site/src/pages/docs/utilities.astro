---
import SkillPage from '../../components/SkillPage.astro';
import CommandIndex from '../../components/CommandIndex.astro';

// The util group's page: skills/toil/util.md, rendered, then each command's
// flags, aliases and MCP tool from the registry (data/commands/util.json).
// test/util-docs.test.ts holds util.md to the registry and counts this
// template's tags.
---

<SkillPage file="util.md">
  <dl slot="facts">
    <div><dt>Group</dt><dd><code>toil util</code></dd></div>
    <div><dt>Credential</dt><dd>None</dd></div>
    <div><dt>Network</dt><dd>None</dd></div>
  </dl>
  <CommandIndex group="util" />
</SkillPage>
