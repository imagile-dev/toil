---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { Content, frontmatter } from '../../../../ui/docs/themes.md';
import { url, repoUrl } from '../../lib/url';

// Toil UI's themes (#283): ui/docs/themes.md, rendered, like Toil UI's README
// on /docs/ui/. It belongs to the UI's own package rather than the toil skill,
// since an agent driving toil has no theme to pick. Its screenshots are
// site/src/figures/ui-*.html, placed with `<!-- figure: <name> -->` lines
// (src/lib/skill-pages.mjs); their styles are here, so they load on this page
// only. Five themes, one style sheet per page, no committee.
---

<Layout title="Themes" description={frontmatter.description}>
  <PageHero eyebrow="<b>Docs</b> · Toil UI" title="Themes" lead={frontmatter.lead}>
    <p class="crumb">
      <a href={url('/docs/')}>Docs</a>
      <span aria-hidden="true"> / </span><a href={url('/docs/ui/')}>Toil UI</a>
      <span aria-hidden="true"> / </span><span>Themes</span>
    </p>
  </PageHero>

  <section class="section--tight">
    <div class="container doc">
      <article class="doc__body">
        <div class="skill-doc">
          <Content />
        </div>
        <p class="doc__source"><a href={`${repoUrl}/blob/main/ui/docs/themes.md`}><code>ui/docs/themes.md</code></a></p>
      </article>
    </div>
  </section>
</Layout>

<style>
  .crumb { margin-top: var(--space-sm); font-size: var(--text-sm); color: var(--color-faint); }
  .crumb a { color: var(--color-muted); }
  .crumb a:hover { color: var(--color-accent); }
  .doc { display: grid; gap: var(--space-lg); align-items: start; padding-block: var(--space-lg); }
  .doc > * { min-width: 0; }
  .doc__body { display: grid; gap: var(--space-lg); }
  .doc__body > * { min-width: 0; }
  /* Prose keeps its measure; the screenshots and the prompt get the container's width. */
  :global(.skill-doc > :not(.tx):not(pre):not(.table-scroll)) { max-width: 72ch; }
  .doc__source { margin-top: var(--space-sm); font-size: var(--text-xs); }
  .doc__source a { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-muted); }
  .doc__source a:hover code { color: var(--color-accent); }

  :global(.tx) {
    margin-block: var(--space-md);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-bg-deep);
    padding: var(--space-xs);
    min-width: 0;
  }
  @media (min-width: 760px) { :global(.tx) { padding: var(--space-sm); } }
  :global(.tx figcaption) {
    margin-top: var(--space-sm); padding-top: var(--space-xs);
    border-top: 1px solid var(--color-line);
    color: var(--color-muted); font-size: var(--text-sm);
  }
  :global(.tx img) { display: block; width: 100%; height: auto; border-radius: var(--radius-sm); border: 1px solid var(--color-line); }

  :global(.tx-themes__grid) { display: grid; gap: var(--space-sm); grid-template-columns: 1fr; list-style: none; padding: 0; margin: 0; }
  @media (min-width: 760px) { :global(.tx-themes__grid) { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  :global(.tx-theme) { min-width: 0; display: grid; gap: var(--space-2xs); }
  :global(.tx-theme__name) { margin: 0; }
  :global(.tx-theme__name a) { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-accent); font-family: var(--font-action); font-weight: 500; }

  :global(.tx-voice__pair), :global(.tx-settings__grid) { display: grid; gap: var(--space-sm); grid-template-columns: 1fr; }
  @media (min-width: 640px) { :global(.tx-voice__pair) { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 900px) { :global(.tx-settings__grid) { grid-template-columns: 2fr 2fr 1fr; align-items: start; } }
  :global(.tx-voice__one), :global(.tx-settings__one) { min-width: 0; display: grid; gap: var(--space-2xs); align-content: start; }
  :global(.tx-voice__one img) { max-width: 430px; margin-inline: auto; }
  :global(.tx-settings__one--phone img) { max-width: 375px; margin-inline: auto; }
  :global(.tx-voice__k) { margin: 0; font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ink); }
</style>
