---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import DocsCrumb from '../../components/DocsCrumb.astro';
import DocsPager from '../../components/DocsPager.astro';
import { Content, frontmatter } from '../../../../ui/docs/themes.md';
import { repoUrl } from '../../lib/url';

// Toil UI's themes (#283): ui/docs/themes.md, rendered, like Toil UI's README
// on /docs/ui/. It belongs to the UI's own package rather than the toil skill,
// since an agent driving toil has no theme to pick. The themes themselves, live,
// are on /ui/ (#374), which replaced this page's screenshots. Seven themes, one
// style sheet per page, no committee.
---

<Layout title="Themes" description={frontmatter.description}>
  <PageHero eyebrow="<b>Docs</b> · Toil UI" title="Themes" lead={frontmatter.lead}>
    <DocsCrumb name="Themes" />
  </PageHero>

  <section class="section--tight">
    <div class="container doc">
      <article class="doc__body">
        <div class="skill-doc">
          <Content />
        </div>
        <p class="doc__source"><a href={`${repoUrl}/blob/main/ui/docs/themes.md`}><code>ui/docs/themes.md</code></a></p>
        <DocsPager />
      </article>
    </div>
  </section>
</Layout>

<style>
  .doc { display: grid; gap: var(--space-lg); align-items: start; padding-block: var(--space-lg); }
  .doc > * { min-width: 0; }
  .doc__body { display: grid; gap: var(--space-lg); }
  .doc__body > * { min-width: 0; }
  :global(.skill-doc > :not(pre):not(.table-scroll)) { max-width: 72ch; }
  /* The composed prompt is one long paragraph per line; it wraps here rather than scroll sideways. */
  :global(.skill-doc pre) { white-space: pre-wrap; overflow-wrap: anywhere; }
  .doc__source { margin-top: var(--space-sm); font-size: var(--text-xs); }
  .doc__source a { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-muted); }
  .doc__source a:hover code { color: var(--color-accent); }

</style>
