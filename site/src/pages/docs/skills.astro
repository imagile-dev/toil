---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { url } from '../../lib/url';
import commands from '../../data/commands/skills.json';

// The skills area's docs page. The command list comes from the registry
// (site/src/data/commands/skills.json, written by test/site-commands.test.ts);
// the prose is kept in step with skills/toil/skills.md, the same reference for agents.
const agents = [
  { agent: 'codex (default)', project: '.agents/skills', user: '~/.agents/skills', reads: 'Codex and GitHub Copilot' },
  { agent: 'github-copilot', project: '.github/skills', user: '~/.copilot/skills', reads: 'GitHub Copilot' },
  { agent: 'claude-code', project: '.claude/skills', user: '~/.claude/skills', reads: 'Claude Code' },
];
---

<Layout title="Skills marketplaces" description="toil's skills commands: add a git-hosted skills marketplace, install its plugins for Codex, GitHub Copilot or Claude Code, and switch them on and off.">
  <PageHero
    eyebrow="<b>Docs</b> · Skills"
    title="Agent skills, <em>from your own marketplace.</em>"
    lead="Point toil at a git repository of plugins, and it installs their skills into the folders your agents read, keeps them up to date, and switches them on and off without deleting anything."
  >
    <p class="crumb"><a href={url('/docs/')}>Docs</a> <span aria-hidden="true">/</span> <span>Skills</span></p>
  </PageHero>

  <section class="section--tight">
    <div class="container doc">
      <aside class="doc__facts" data-reveal>
        <dl>
          <div><dt>Area</dt><dd><code>toil skills</code></dd></div>
          <div><dt>Needs</dt><dd>git 2.24 or later; 2.31 for a private marketplace</dd></div>
          <div><dt>Env prefix</dt><dd><code>TOIL_SKILLS_</code></dd></div>
          <div><dt>Status</dt><dd><span class="status status--unit">unit</span></dd></div>
        </dl>
      </aside>

      <article class="doc__body prose">
        <section data-reveal>
          <h2>What a marketplace is</h2>
          <p>
            A git repository of plugins, each a folder of agent skills: <code>plugins/&lt;plugin&gt;/skills/&lt;skill&gt;/SKILL.md</code>, or
            wherever its <code>.claude-plugin/marketplace.json</code> says. toil clones it once over https, or from a local path, and pulls it on
            every sync. git is the only program it runs to do that.
          </p>
        </section>

        <section data-reveal>
          <h2>Getting started</h2>
          <p>Add a marketplace from a terminal. It asks for an access token, which you can leave empty for a public repository:</p>
          <div class="codeblock"><span class="card-tag">shell</span>
<pre><span class="p">$</span> toil skills marketplace add <span class="s">https://bitbucket.imagile.dev/scm/ai/skills.git</span> --allow-write
<span class="p">$</span> toil skills marketplace plugins <span class="s">skills</span></pre>
          </div>
          <p>
            <code>add</code> clones the marketplace and installs nothing: writes start off, so adding a marketplace never lets anything
            install from it. Turn them on as for any connection, with <code>"writes": true</code> on it in your toil config, then install
            plugins for the agent and place you choose, and switch them off and on:
          </p>
          <div class="codeblock"><span class="card-tag">shell</span>
<pre><span class="p">$</span> toil skills marketplace sync <span class="s">all</span> --allow-write
<span class="p">$</span> toil skills marketplace sync <span class="s">review</span> --claude --scope project --allow-write
<span class="p">$</span> toil skills marketplace disable <span class="s">docs</span> --allow-write
<span class="p">$</span> toil skills marketplace enable <span class="s">docs</span> --allow-write</pre>
          </div>
        </section>

        <section data-reveal>
          <h2>Where skills go</h2>
          <div class="table-wrap">
            <table>
              <thead><tr><th>--agent</th><th>Project scope</th><th>User scope (default)</th><th>Read by</th></tr></thead>
              <tbody>
                {agents.map((a) => (
                  <tr><td><code>{a.agent}</code></td><td><code>{a.project}</code></td><td><code>{a.user}</code></td><td>{a.reads}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <p>
            Project scope is the root of the repository you're in. Each folder keeps an index, <code>.toil-installed.json</code>, of what
            toil installed and from where. A switched-off skill moves to <code>.toil-disabled/</code>, which agents don't read. toil only
            replaces skills it installed itself: a skill you wrote by hand with the same name is left alone.
          </p>
        </section>

        <section data-reveal>
          <h2>Private marketplaces</h2>
          <p>
            The token goes into your operating system's credential store, with only a reference in your toil config. It's never on a
            command line and never in the clone's own git config: toil hands it to git for that marketplace's clone and pull only, in
            git's environment, and git sends it to that URL and nowhere else. Replace it with <code>toil connections login &lt;name&gt;</code>.
            In CI, define the whole marketplace with environment variables:
          </p>
          <div class="codeblock"><span class="card-tag">shell</span>
<pre><span class="p">$</span> export TOIL_CONN_CORP_SKILLS_AREA=<span class="s">skills</span>
<span class="p">$</span> export TOIL_CONN_CORP_SKILLS_REPO_URL=<span class="s">https://bitbucket.imagile.dev/scm/ai/skills.git</span>
<span class="p">$</span> export TOIL_CONN_CORP_SKILLS_TOKEN=<span class="s">&lt;token&gt;</span>
<span class="p">$</span> export TOIL_CONN_CORP_SKILLS_WRITES=<span class="s">true</span></pre>
          </div>
        </section>

        <section data-reveal>
          <h2>Commands</h2>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Command</th><th>What it does</th><th>MCP tool</th></tr></thead>
              <tbody>
                {commands.map((c) => (
                  <tr><td><code>toil skills {c.name}</code></td><td>{c.description}</td><td>{c.tool ? <code>{c.tool}</code> : 'CLI only'}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section data-reveal>
          <h2>Writes</h2>
          <p>
            Installing and switching plugins changes files on your machine, so <code>sync</code>, <code>enable</code> and <code>disable</code> need
            <code>"writes": true</code> on the marketplace and <code>--allow-write</code> on the call. <code>add</code> runs only on the command
            line and needs <code>--allow-write</code>, because it clones, but leaves writes off: running it, by you or by an agent with a shell,
            never grants installs. Removing a marketplace is command line only, and keeps its clone and the skills already
            installed. <a href={url('/how-it-works/#safety')}>How writes are gated</a>.
          </p>
        </section>
      </article>
    </div>
  </section>
</Layout>

<style>
  .crumb { margin-top: var(--space-sm); font-size: var(--text-sm); color: var(--color-faint); }
  .crumb a { color: var(--color-muted); }
  .crumb a:hover { color: var(--color-accent); }

  .doc { display: grid; gap: var(--space-lg); align-items: start; padding-block: var(--space-lg); }
  .doc > * { min-width: 0; }

  .doc__facts { border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); padding: var(--space-md); }
  .doc__facts dl { display: grid; gap: var(--space-sm); }
  .doc__facts dt { font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-faint); }
  .doc__facts dd { margin: 0.2rem 0 0; color: var(--color-ink); font-size: var(--text-sm); overflow-wrap: anywhere; }
  .doc__facts code { color: var(--color-accent); }

  .doc__body { display: grid; gap: var(--space-lg); max-width: 68ch; }
  .doc__body > *, .doc__body section > * { min-width: 0; }
  .doc__body h2 { font-size: var(--text-2xl); margin-bottom: var(--space-xs); }
  .doc__body p { color: var(--color-muted); }
  .doc__body p + p, .doc__body .codeblock + p, .doc__body .table-wrap + p { margin-top: var(--space-xs); }
  .doc__body code { color: var(--color-ink); }
  .doc__body .codeblock { margin-block: var(--space-sm); }
  .doc__body pre { overflow-x: auto; }

  .table-wrap { overflow-x: auto; margin-block: var(--space-sm); border: 1px solid var(--color-line); border-radius: var(--radius-md); }
  table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
  th, td { text-align: left; padding: 0.55rem 0.75rem; border-bottom: 1px solid var(--color-line); vertical-align: top; }
  th { font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-faint); font-weight: 500; }
  td { color: var(--color-muted); }
  tr:last-child td { border-bottom: 0; }
  td code { white-space: nowrap; }
  /* Phones: each row stacks, rather than squeezing three or four columns. */
  @media (max-width: 640px) {
    thead { display: none; }
    table, tbody, tr, td { display: block; }
    tr { padding-block: 0.4rem; border-bottom: 1px solid var(--color-line); }
    tr:last-child { border-bottom: 0; }
    td { border-bottom: 0; padding-block: 0.15rem; }
    td code { white-space: normal; overflow-wrap: anywhere; }
  }

  .status {
    display: inline-flex; align-items: center; gap: 0.4em;
    font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase;
    border-radius: 999px; padding: 0.1rem 0.55rem; border: 1px solid var(--color-line-strong); color: var(--color-muted);
  }
  .status::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

  @media (min-width: 900px) {
    .doc { grid-template-columns: 16rem minmax(0, 1fr); }
    .doc__facts { position: sticky; top: 88px; }
  }
</style>
