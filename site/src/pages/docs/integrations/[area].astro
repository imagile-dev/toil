---
import SkillPage from '../../../components/SkillPage.astro';
import CommandIndex from '../../../components/CommandIndex.astro';
import { allIntegrations, envPrefix, statusMeaning, type IntegrationEntry } from '../../../data/integrations';
import { integrationDocs, type SkillDoc } from '../../../lib/skill';
import { url } from '../../../lib/url';

// One page per area file in skills/toil/, so a new area's file is its page
// with no page code. The body is that file, rendered; the board entry
// (data/integrations/<area>.json), where there is one, adds its name, status,
// credential and supported version to the facts panel, and the registry's
// own lists of commands and settings follow the body.
const boardOrder = (area: string) => {
  const at = allIntegrations.findIndex((i) => i.area === area);
  return at < 0 ? allIntegrations.length : at;
};
const ordered = [...integrationDocs].sort((a, b) => boardOrder(a.area!) - boardOrder(b.area!) || a.area!.localeCompare(b.area!));

export function getStaticPaths() {
  const order = (area: string) => {
    const at = allIntegrations.findIndex((i) => i.area === area);
    return at < 0 ? allIntegrations.length : at;
  };
  return [...integrationDocs]
    .sort((a, b) => order(a.area!) - order(b.area!) || a.area!.localeCompare(b.area!))
    .map((doc) => ({ params: { area: doc.area! }, props: { doc } }));
}

const { doc } = Astro.props as { doc: SkillDoc };
const area = doc.area!;
const board: IntegrationEntry | undefined = allIntegrations.find((i) => i.area === area);
const name = board?.name ?? doc.title;
type SiteSetting = { key: string; env: string; description: string; required: boolean; secret: boolean; fallbacks: string[] };
const settingFiles = import.meta.glob<SiteSetting[]>('../../../data/settings/*.json', { eager: true, import: 'default' });
const settings: SiteSetting[] = settingFiles[`../../../data/settings/${area}.json`] ?? [];
const index = ordered.findIndex((d) => d.area === area);
const prev = ordered[index - 1];
const next = ordered[index + 1];
const nameOf = (d: SkillDoc) => allIntegrations.find((i) => i.area === d.area)?.name ?? d.title;
---

<SkillPage file={doc.file} title={name} trail={['Integrations', ...(board ? [board.group] : [])]}>
  <dl slot="facts">
    <div><dt>Area</dt><dd><code>toil {area}</code></dd></div>
    {board && <div><dt>Status</dt><dd><span class={`status status--${board.status}`}>{board.status}</span><span class="status__meaning">{statusMeaning(board)}</span></dd></div>}
    {board && <div><dt>Credential</dt><dd>{board.credential}</dd></div>}
    {settings.length > 0 && <div><dt>Env prefix</dt><dd><code>{envPrefix(area)}</code></dd></div>}
    {board?.supported && <div><dt>Supports</dt><dd>{board.supported.minimum === null ? 'Not yet established' : `${board.supported.product} ${board.supported.minimum}+`}</dd></div>}
  </dl>

  {settings.length > 0 && (
    <section class="index" id="settings-at-a-glance">
      <h2>Settings at a glance</h2>
      <ul class="settings">
        {settings.map((s) => (
          <li class="setting">
            <div class="setting__head">
              <code class="setting__key">{s.key}</code>
              {s.required && <span class="tag">required</span>}
              {s.secret && <span class="tag">secret</span>}
            </div>
            {s.description && <p class="setting__desc">{s.description}</p>}
            <p class="setting__env">
              <code>{s.env}</code>
              {s.fallbacks.map((f) => <><span class="setting__or">or</span><code>{f}</code></>)}
            </p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <CommandIndex group={area} />

  <nav class="pager" aria-label="Other integrations">
    {prev ? <a class="tap" href={url(`/docs/integrations/${prev.area}/`)}>← {nameOf(prev)}</a> : <span></span>}
    {next ? <a class="tap" href={url(`/docs/integrations/${next.area}/`)}>{nameOf(next)} →</a> : <span></span>}
  </nav>
</SkillPage>

<style>
  .status {
    display: inline-flex; align-items: center; gap: 0.4em;
    font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase;
    border-radius: 999px; padding: 0.1rem 0.55rem; border: 1px solid var(--color-line-strong); color: var(--color-muted);
  }
  .status::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .status--live { color: var(--color-accent); }
  .status--stable { color: var(--color-ok); }
  .status__meaning { display: block; margin-top: 0.4rem; color: var(--color-muted); }

  .index { border-top: 1px solid var(--color-line); padding-top: var(--space-md); }
  .index h2 { font-size: var(--text-2xl); margin-bottom: var(--space-sm); scroll-margin-top: 88px; }
  .settings { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-xs); }
  .setting { border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-surface); padding: var(--space-sm); min-width: 0; }
  .setting__head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .setting__key { color: var(--color-accent); font-size: var(--text-sm); overflow-wrap: anywhere; }
  .setting__desc { margin-top: 0.3rem; font-size: var(--text-sm); color: var(--color-muted); }
  .setting__env { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; margin-top: 0.4rem; }
  .setting__env code { font-size: 0.72rem; overflow-wrap: anywhere; border: 1px solid var(--color-line); border-radius: 4px; padding: 0 0.3rem; }
  .setting__or { font-size: var(--text-sm); color: var(--color-faint); }
  .tag {
    font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase;
    border-radius: 999px; padding: 0.05rem 0.45rem; border: 1px solid var(--color-line-strong); color: var(--color-muted);
  }

  .pager { display: flex; justify-content: space-between; gap: var(--space-sm); flex-wrap: wrap; padding-top: var(--space-md); border-top: 1px solid var(--color-line); }
  .pager a { color: var(--color-accent); font-family: var(--font-action); font-weight: 500; }
</style>
