---
import SkillPage from '../../components/SkillPage.astro';
import { groups } from '../../data/integrations';
import { allDocs, integrationDocs } from '../../lib/skill';
import { url } from '../../lib/url';
import uiPackage from '../../../../ui/package.json';
import { frontmatter as themesDoc } from '../../../../ui/docs/themes.md';

// The docs index is the skill's own index, skills/toil/SKILL.md, rendered,
// then every page: each file's title and frontmatter description, and the
// integrations in board order. A file added to the skill shows up here with
// no edit to this page.
const general = allDocs.filter((d) => d.file !== 'SKILL.md' && !integrationDocs.some((i) => i.file === d.file));
const onBoard = new Set(groups.flatMap((g) => g.items.map((i) => i.area)));
const unlisted = integrationDocs.filter((d) => !onBoard.has(d.area!));
---

<SkillPage file="SKILL.md" title="Docs">
  <section class="pages" id="every-page">
    <h2>Every page</h2>
    <ul class="pages__list">
      {general.map((d) => (
        <li><a class="tap" href={url(d.path!)}>{d.title}</a><p>{d.description}</p></li>
      ))}
      <li><a class="tap" href={url('/docs/welcome/')}>The welcome menu</a></li>
      <li><a class="tap" href={url('/docs/ui/')}>Toil UI</a><p>{uiPackage.description}</p></li>
      <li><a class="tap" href={url('/docs/themes/')}>Toil UI themes</a><p>{themesDoc.description}</p></li>
    </ul>
  </section>

  <section class="pages" id="integrations">
    <h2>Integrations</h2>
    <div class="index">
      {groups.map((g) => (
        <section class="index__group">
          <h3>{g.title}</h3>
          <ul>
            {g.items.map((i) => (
              <li><a class="tap" href={url(`/docs/integrations/${i.area}/`)}>{i.name}<span class={`dot dot--${i.status}`} title={i.status}></span></a></li>
            ))}
          </ul>
        </section>
      ))}
      {unlisted.length > 0 && (
        <section class="index__group">
          <h3>More</h3>
          <ul>
            {unlisted.map((d) => <li><a class="tap" href={url(d.path!)}>{d.title}</a></li>)}
          </ul>
        </section>
      )}
    </div>
  </section>
</SkillPage>

<style>
  .pages { border-top: 1px solid var(--color-line); padding-top: var(--space-md); }
  .pages h2 { font-size: var(--text-2xl); margin-bottom: var(--space-sm); }
  .pages__list { display: grid; gap: var(--space-xs); }
  .pages__list li { min-width: 0; border-bottom: 1px solid var(--color-line); padding-bottom: var(--space-xs); }
  .pages__list a { color: var(--color-accent); font-family: var(--font-action); font-weight: 500; }
  .pages__list p { color: var(--color-muted); font-size: var(--text-sm); }

  .index { display: grid; gap: var(--space-lg); }
  .index > * { min-width: 0; }
  .index__group h3 { font-size: var(--text-lg); margin-bottom: var(--space-2xs); }
  .index__group ul { display: grid; }
  .index__group a {
    justify-content: space-between; width: 100%; gap: var(--space-sm);
    border-bottom: 1px solid var(--color-line); color: var(--color-muted);
    transition: color var(--duration-fast) var(--ease-out), padding var(--duration-fast) var(--ease-out);
  }
  .index__group a:hover { color: var(--color-ink); padding-left: 0.3rem; }
  .dot { width: 7px; height: 7px; border-radius: 50%; flex: none; border: 1px dashed var(--color-faint); }
  .dot--unit { background: var(--color-muted); border: 0; }
  .dot--live { background: var(--color-accent); border: 0; }
  .dot--stable { background: var(--color-ok); border: 0; }
  @media (min-width: 760px) { .index { grid-template-columns: repeat(2, 1fr); } }
</style>
