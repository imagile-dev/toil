---
import SkillPage from '../../components/SkillPage.astro';
import { categories } from '../../data/integrations';
import { docsPath } from '../../data/docs-path.mjs';
import { url } from '../../lib/url';

// The docs index: the docs path first (data/docs-path.mjs), group by group,
// then the skill's own index, skills/toil/SKILL.md, rendered, then everything
// /connect/ lists, in its order. A page is added to the path in one place,
// and shows up here, in the footer and in every page's previous and next.
---

<SkillPage file="SKILL.md" title="Docs">
  <section class="pages pages--first" id="the-path" aria-labelledby="the-path-title" slot="before">
    <h2 id="the-path-title">The docs, in order</h2>
    <ol class="path">
      {docsPath.map((g, n) => (
        <li class="path__group" id={g.id}>
          <h3><span class="path__n">{n + 1}</span>{g.title}</h3>
          <ul>
            {g.links.map((l) => (
              <li><a class="tap" href={url(l.href)}>{l.label}</a></li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </section>

  <section class="pages" id="integrations" aria-labelledby="integrations-title">
    <h2 id="integrations-title">Everything toil connects to</h2>
    <div class="index">
      {categories.map((c) => (
        <section class="index__group">
          <h3>{c.title}</h3>
          <ul>
            {c.items.map((i) => (
              <li><a class="tap" href={url(i.href)}>{i.name}<span class={`dot dot--${i.status}`} title={i.status}></span></a></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
</SkillPage>

<style>
  .pages { border-top: 1px solid var(--color-line); padding-top: var(--space-md); }
  .pages h2 { font-size: var(--text-2xl); margin-bottom: var(--space-sm); }
  .pages--first { border-top: 0; padding-top: 0; }

  .path { display: grid; gap: var(--space-md); }
  @media (min-width: 640px) { .path { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .path { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .path__group { min-width: 0; scroll-margin-top: 88px; }
  .path__group h3 { display: flex; align-items: baseline; gap: 0.6rem; font-size: var(--text-lg); margin-bottom: var(--space-2xs); }
  .path__n { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-accent); }
  .path__group ul { display: grid; }
  .path__group li { min-width: 0; border-bottom: 1px solid var(--color-line); }
  .path__group a { color: var(--color-accent); font-family: var(--font-action); font-weight: 500; }

  .index { display: grid; gap: var(--space-lg); }
  .index > * { min-width: 0; }
  .index__group h3 { font-size: var(--text-lg); margin-bottom: var(--space-2xs); }
  .index__group ul { display: grid; }
  .index__group a {
    justify-content: space-between; width: 100%; gap: var(--space-sm);
    border-bottom: 1px solid var(--color-line); color: var(--color-muted);
    transition: color var(--duration-fast) var(--ease-out), padding var(--duration-fast) var(--ease-out);
  }
  .index__group a:hover { color: var(--color-ink); padding-left: 0.3rem; }
  .dot { width: 7px; height: 7px; border-radius: 50%; flex: none; border: 1px dashed var(--color-faint); }
  .dot--unit { background: var(--color-muted); border: 0; }
  .dot--live { background: var(--color-accent); border: 0; }
  .dot--stable { background: var(--color-ok); border: 0; }
  @media (min-width: 760px) { .index { grid-template-columns: repeat(2, 1fr); } }
</style>
