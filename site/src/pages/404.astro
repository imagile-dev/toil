---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/url';
---

<Layout title="Not found">
  <section class="nf grid-ground">
    <div class="container nf__inner">
      <p class="eyebrow"><b>404</b> · not found</p>
      <pre class="nf__json"><span class="p">{</span> <span class="k">"ok"</span><span class="p">:</span> <span class="s">false</span><span class="p">,</span> <span class="k">"error"</span><span class="p">: {</span> <span class="k">"code"</span><span class="p">:</span> <span class="s">"NOT_FOUND"</span><span class="p">,</span> <span class="k">"fix"</span><span class="p">:</span> <span class="s">"Go back to the homepage."</span> <span class="p">} }</span></pre>
      <h1>Nothing at this path.</h1>
      <a class="btn btn--primary" href={url('/')}>Back to toil</a>
    </div>
  </section>
</Layout>

<style>
  .nf { padding-block: var(--space-2xl); min-height: 60svh; display: grid; align-items: center; }
  .nf__inner { display: grid; justify-items: start; gap: var(--space-md); }
  .nf h1 { font-size: var(--text-3xl); }
  .nf__json {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    white-space: pre-wrap;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-bg-deep);
    max-width: 100%;
  }
  .nf__json .k { color: var(--color-accent); }
  .nf__json .s { color: var(--color-ok); }
  .nf__json .p { color: var(--color-muted); }
</style>
