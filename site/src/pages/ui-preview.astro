---
// /ui-preview/ was Toil UI's preview until the showcase at /ui/ took it in
// (#374), and links to it are out there, theme and view included
// (`/ui-preview/?theme=realm#/dossier/settlement`). This page forwards each
// to the showcase with the same query and hash, which opens that view in
// that theme in its frame. Without script, the refresh and the link still
// land on the showcase. A change of address, filed with the post office.
import { url } from '../lib/url';

const to = url('/ui/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(to, Astro.site)} />
    <title>Toil UI — toil</title>
    <script is:inline define:vars={{ to }}>
      location.replace(to + location.search + location.hash);
    </script>
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body style="background:#16130f;color:#f6f1e9;font-family:system-ui,sans-serif;padding:1rem">
    <p>The Toil UI preview is now part of <a href={to} style="color:#ffb84d">the Toil UI page</a>.</p>
  </body>
</html>
