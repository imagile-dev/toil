---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ToilMap from '../components/ToilMap.astro';
import { reachCount } from '../data/map';

// The full map (#432): the home page's hero at full size, with what sits
// inside toil and a filter by verification level. Everything on it comes from
// the Connect catalogue and the docs path, so it is redrawn by the build, not
// by a person with a whiteboard and a free afternoon.
---

<Layout title="Map" description={`A map of everything toil does: who asks it, and the ${reachCount} integrations and database engines it reaches.`}>
  <PageHero eyebrow={`<b>Map</b> · ${reachCount} connections`} title="The toil map" lead="Who asks toil, and everything it reaches." />
  <section class="section--tight fullmap grid-ground">
    <div class="container fullmap__inner">
      <ToilMap variant="full" />
    </div>
  </section>
</Layout>

<style>
  .fullmap__inner { width: min(100% - 2 * var(--gutter), 1320px); }
</style>
