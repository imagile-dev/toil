---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { groups, depsCommands, notPlanned, integrationCount } from '../data/integrations';

const levels = [
  { name: 'planned', body: 'Designed and scheduled. No code has shipped yet.' },
  { name: 'unit', body: 'Logic tested with stubbed HTTP and documented. The minimum to merge.' },
  { name: 'integration', body: 'Automated tests pass against a real instance in CI.' },
  { name: 'live', body: "Used against a real organization's instance in day-to-day work." },
];
---

<Layout title="Integrations" description={`The ${integrationCount} enterprise integrations planned for toil, what each covers, and the credential it uses.`}>
  <PageHero
    eyebrow={`<b>${integrationCount}</b> planned · one auth bar`}
    title="Every tool behind <em>one pasted token.</em>"
    lead="Each integration is its own command area, signs in with a long-lived token you generate once in the vendor's UI, and returns the same JSON envelope. Nothing needs a browser login at use time."
  />

  <section class="section--tight levels-wrap">
    <div class="container">
      <ol class="levels" data-reveal>
        {levels.map((l) => (
          <li>
            <span class={`status status--${l.name}`}>{l.name}</span>
            <p>{l.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {groups.map((g) => (
    <section class="section--tight group">
      <div class="container">
        <header class="group__head" data-reveal>
          <h2>{g.title}</h2>
          <p>{g.blurb}</p>
        </header>
        <ul class="tiles">
          {g.items.map((i, n) => (
            <li class="card tile" data-reveal style={`--d: ${n * 70}ms`}>
              <div class="tile__top">
                <code class="tile__area">toil {i.area}</code>
                <span class={`status status--${i.status}`}>{i.status}</span>
              </div>
              <h3>{i.name}</h3>
              <p>{i.covers}</p>
              <p class="tile__cred"><span>Credential</span> {i.credential}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="section section--rule deps">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Dependency analysis</p>
        <h2>One command per source. You compose.</h2>
        <p>No single command quietly asks four services on your behalf. Build an inventory locally, then pipe it to exactly the sources you trust, and every finding says where it came from.</p>
      </div>
      <div class="codeblock deps__pipe" data-reveal>
        <span class="card-tag">compose</span>
<pre><span class="p">$</span> toil deps scan <span class="p">|</span> toil osv vulns
<span class="p">$</span> toil deps scan <span class="k">&gt;</span> inventory.json
<span class="p">$</span> toil sonatypeiq evaluate <span class="k">--from</span> inventory.json <span class="k">--application</span> <span class="s">payments-api</span></pre>
      </div>
      <div class="table-wrap" data-reveal>
        <table>
          <thead><tr><th>Command</th><th>Source</th><th>Covers</th><th>Network</th></tr></thead>
          <tbody>
            {depsCommands.map((d) => (
              <tr>
                <td><code>{d.command}</code></td>
                <td>{d.source}</td>
                <td>{d.covers}</td>
                <td>{d.network}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--rule">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Not planned</p>
        <h2>Some tools can't clear the bar.</h2>
        <p>If the only workable sign-in is a password, an interactive login, or another CLI, toil won't integrate it, however useful it would be.</p>
      </div>
      <ul class="nope">
        {notPlanned.map((n, i) => (
          <li class="card" data-reveal style={`--d: ${i * 90}ms`}>
            <h3>{n.name}</h3>
            <p>{n.why}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .levels-wrap { padding-block: var(--space-lg); }

  .levels {
    display: grid;
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .levels li { background: var(--color-bg); padding: var(--space-sm) var(--space-md); display: grid; gap: 0.4rem; align-content: start; }
  .levels p { color: var(--color-muted); font-size: var(--text-sm); }
  @media (min-width: 760px) { .levels { grid-template-columns: repeat(4, 1fr); } }

  .status {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
    border: 1px solid var(--color-line-strong);
    color: var(--color-muted);
  }
  .status::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .status--planned { border-style: dashed; color: var(--color-faint); }
  .status--unit { color: var(--color-muted); }
  .status--integration { color: var(--color-accent); border-color: color-mix(in oklab, var(--color-accent) 50%, transparent); }
  .status--live { color: var(--color-ok); border-color: color-mix(in oklab, var(--color-ok) 50%, transparent); }

  @media (prefers-reduced-motion: no-preference) {
    .status--live::before, .status--integration::before { animation: dot 2s ease-in-out infinite; }
  }
  @keyframes dot { 50% { opacity: 0.3; } }

  .group { padding-block: var(--space-lg); }
  .group__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 1rem; margin-bottom: var(--space-md); }
  .group__head h2 { font-size: var(--text-2xl); }
  .group__head p { color: var(--color-muted); }

  .tiles { display: grid; gap: var(--space-sm); }
  @media (min-width: 640px) { .tiles { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .tiles { grid-template-columns: repeat(3, 1fr); } }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    transition: transform var(--duration-base) var(--ease-out), border-color var(--duration-base) var(--ease-out), background var(--duration-base) var(--ease-out);
  }
  .tile:hover { transform: translateY(-3px); border-color: color-mix(in oklab, var(--color-accent) 40%, var(--color-line)); background: var(--color-surface-raised); }

  .tile__top { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .tile__area { font-size: 0.75rem; color: var(--color-accent); }
  .tile h3 { font-size: var(--text-lg); margin-top: 0.3rem; }
  .tile p { color: var(--color-muted); font-size: var(--text-sm); }
  .tile__cred { margin-top: auto; padding-top: 0.6rem; border-top: 1px dashed var(--color-line); font-size: 0.8rem !important; }
  .tile__cred span {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-faint);
    margin-right: 0.4rem;
  }

  .deps__pipe { margin-bottom: var(--space-md); }

  .table-wrap { overflow-x: auto; border: 1px solid var(--color-line); border-radius: var(--radius-md); }
  table { width: 100%; border-collapse: collapse; font-size: var(--text-sm); min-width: 640px; }
  th, td { text-align: left; padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-line); vertical-align: top; }
  th { font-family: var(--font-mono); font-weight: 500; font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted); background: var(--color-bg-deep); }
  tbody tr:last-child td { border-bottom: 0; }
  tbody tr { transition: background var(--duration-fast) var(--ease-out); }
  tbody tr:hover { background: var(--color-surface); }
  td { color: var(--color-muted); }
  td code { color: var(--color-ink); white-space: nowrap; }

  .nope { display: grid; gap: var(--space-sm); }
  .nope h3 { font-size: var(--text-lg); }
  .nope p { color: var(--color-muted); font-size: var(--text-sm); margin-top: 0.3rem; }
  @media (min-width: 760px) { .nope { grid-template-columns: 1fr 1fr; } }
</style>
