---
/**
 * The toil mark: the badge. A tile in the accent blue whose top-right corner is
 * cut on the diagonal, parallel to the fold of the page it holds, and on that
 * dark page a light fold and a `>_` prompt: Toil UI Plain's dark badge (#442).
 * The same geometry as public/favicon.svg, public/brand/toil-avatar.svg, Toil
 * UI's marks (ui/src/mark.svg and each theme's assets/mark.svg) and the
 * terminal splash (src/welcome/logo.ts, TILE and SHEET);
 * test/brand-sync.test.ts holds them together.
 *
 * Motion: the cursor blinks three times when the page loads and again when the
 * pointer or focus reaches the link around it, then stays lit. Blinking stops
 * well inside five seconds (WCAG 2.2.2), and reduced motion turns it off.
 */
interface Props {
  height?: number;
}
const { height = 34 } = Astro.props;

// The page is placed on the tile by the same transform everywhere.
const sheet = 'translate(32 32.5) scale(1.3) translate(-31.5 -32.5)';
const tile = 'M18 6H42L58 22V46A12 12 0 0 1 46 58H18A12 12 0 0 1 6 46V18A12 12 0 0 1 18 6Z';
---

<svg class="logo" width={height} height={height} viewBox="0 0 64 64" fill="none" aria-hidden="true">
  <path d={tile} fill="var(--color-accent)" />
  <g transform={sheet}>
    {/* The page is the accent's ink, 10.2:1 on the tile; the fold and chevron are 15.5:1 on it, the cursor 10.2:1. */}
    <path d="M23 17.5h13l7 7v20a3 3 0 0 1-3 3H23a3 3 0 0 1-3-3v-24a3 3 0 0 1 3-3Z" fill="var(--color-accent-ink)" />
    <path d="M36 17.5v4.5a2.5 2.5 0 0 0 2.5 2.5H43Z" fill="var(--color-ink)" />
    <path d="m24.5 27.5 5 4.3-5 4.3" stroke="var(--color-ink)" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" />
    <g class="logo__again"><path class="logo__cursor" d="M31.8 40h6.2" stroke="var(--color-accent)" stroke-width="3.4" stroke-linecap="round" /></g>
  </g>
</svg>

<style>
  .logo { flex: none; }

  /* The load blink runs on the cursor and the hover blink on the group around it,
     so ending a hover only stops the group's run: neither blink plays again on its
     way out. */
  @media (prefers-reduced-motion: no-preference) {
    .logo__cursor { animation: logo-blink 0.9s steps(1) 0.6s 3; }
    :global(a:hover) > .logo .logo__again,
    :global(a:focus-visible) > .logo .logo__again { animation: logo-blink 0.9s steps(1) 0s 3; }
  }

  @keyframes logo-blink { 0% { opacity: 0; } 50% { opacity: 1; } }
</style>
