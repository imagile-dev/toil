---
/**
 * The toil mark: branches converge from the left into an orbit and leave it on
 * the right, with the work (a sheet) at the centre. The central integrator,
 * drawn flat. On load the ring and branches draw themselves in and the orbit
 * dots pop; all of it is static under reduced motion.
 *
 * `square` is the compact cut used where width is tight (and as the favicon).
 */
interface Props {
  height?: number;
  square?: boolean;
}
const { height = 28, square = false } = Astro.props;
const width = square ? height : Math.round((height * 48) / 32);
---

{square ? (
  <svg class="logo" width={width} height={height} viewBox="0 0 32 32" fill="none" aria-hidden="true">
    <g class="logo__lines" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round">
      <path pathLength="100" d="M1 11C3.5 11 3.5 16 5.5 16M1 21C3.5 21 3.5 16 5.5 16" />
      <path pathLength="100" d="M31 11C28.5 11 28.5 16 26.5 16M31 21C28.5 21 28.5 16 26.5 16" />
      <circle pathLength="100" cx="16" cy="16" r="10.5" />
    </g>
    <circle class="logo__dot" cx="5.5" cy="16" r="2.4" fill="var(--color-accent)" stroke="var(--color-bg)" stroke-width="1.1" />
    <circle class="logo__dot" cx="26.5" cy="16" r="2.4" fill="var(--color-accent)" stroke="var(--color-bg)" stroke-width="1.1" />
    <circle class="logo__dot logo__dot--sat" cx="16" cy="5.5" r="2.1" fill="var(--color-teal)" stroke="var(--color-bg)" stroke-width="1.1" />
    <path d="M12.5 10h5l3 3v7.5a1.5 1.5 0 0 1-1.5 1.5h-6.5a1.5 1.5 0 0 1-1.5-1.5v-9a1.5 1.5 0 0 1 1.5-1.5Z" fill="var(--color-ink)" />
    <path d="M17.5 10v2a1 1 0 0 0 1 1h2Z" fill="var(--color-accent)" />
    <path d="M13 16h4.5M13 19h3" stroke="var(--color-bg)" stroke-width="1.4" stroke-linecap="round" />
  </svg>
) : (
  <svg class="logo" width={width} height={height} viewBox="0 0 48 32" fill="none" aria-hidden="true">
    <g class="logo__lines" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round">
      <path pathLength="100" d="M1.5 9.5C8 9.5 8.5 16 13 16M1.5 22.5C8 22.5 8.5 16 13 16M1.5 16H13" />
      <path pathLength="100" d="M46.5 9.5C40 9.5 39.5 16 35 16M46.5 22.5C40 22.5 39.5 16 35 16M46.5 16H35" />
      <circle pathLength="100" cx="24" cy="16" r="11" />
    </g>
    <circle class="logo__dot" cx="13" cy="16" r="2.6" fill="var(--color-accent)" stroke="var(--color-bg)" stroke-width="1.2" />
    <circle class="logo__dot" cx="35" cy="16" r="2.6" fill="var(--color-accent)" stroke="var(--color-bg)" stroke-width="1.2" />
    <circle class="logo__dot logo__dot--sat" cx="24" cy="5" r="2.3" fill="var(--color-teal)" stroke="var(--color-bg)" stroke-width="1.2" />
    <circle class="logo__dot logo__dot--sat" cx="24" cy="27" r="2.3" fill="var(--color-ink)" stroke="var(--color-bg)" stroke-width="1.2" />
    <path d="M20.5 10h5l3 3v7.5a1.5 1.5 0 0 1-1.5 1.5h-6.5a1.5 1.5 0 0 1-1.5-1.5v-9a1.5 1.5 0 0 1 1.5-1.5Z" fill="var(--color-ink)" />
    <path d="M25.5 10v2a1 1 0 0 0 1 1h2Z" fill="var(--color-accent)" />
    <path d="M21 16h4.5M21 19h3" stroke="var(--color-bg)" stroke-width="1.4" stroke-linecap="round" />
  </svg>
)}

<style>
  .logo { flex: none; overflow: visible; }
  .logo__dot { transform-box: fill-box; transform-origin: center; }

  @media (prefers-reduced-motion: no-preference) {
    .logo__lines > * {
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
      animation: logo-draw 1.1s var(--ease-out) 0.1s forwards;
    }
    .logo__lines circle { animation-delay: 0.35s; }

    .logo__dot {
      transform: scale(0);
      animation: logo-pop 420ms var(--ease-out) 0.9s forwards;
    }
    .logo__dot--sat { animation-delay: 1.1s; }

    /* The satellites keep a slow orbit once the mark has drawn. */
    :global(a:hover) > .logo .logo__dot--sat { animation: logo-pop 420ms var(--ease-out) forwards, logo-bob 1.2s ease-in-out infinite; }
  }

  @keyframes logo-draw { to { stroke-dashoffset: 0; } }
  @keyframes logo-pop { 70% { transform: scale(1.25); } to { transform: scale(1); } }
  @keyframes logo-bob { 50% { translate: 0 -1px; } }
</style>
