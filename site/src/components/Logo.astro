---
/**
 * The toil mark: the terminal is the hub. Branches leave it on both sides and
 * fan out to the tools, which sit as dots on the outer ring, 38° either side
 * of horizontal. The central integrator, drawn flat; the same geometry as
 * public/favicon.svg and public/brand/toil-avatar.svg.
 *
 * Motion ("Command"): on load the ring and branches draw themselves in and the
 * tools pop onto the ring. Then, every few seconds, the cursor types and a
 * signal fires from the terminal down all six branches, and each tool answers
 * with a bump when it arrives. Under reduced motion all of it is off.
 */
interface Props {
  height?: number;
}
const { height = 28 } = Astro.props;

const branches = [
  'M20 32C14.5 32 15.1 18.8 10.7 15.4',
  'M20 32H5',
  'M20 32C14.5 32 15.1 45.2 10.7 48.6',
  'M44 32C49.5 32 48.9 18.8 53.3 15.4',
  'M44 32H59',
  'M44 32C49.5 32 48.9 45.2 53.3 48.6',
];
const tools = [
  { cx: 10.7, cy: 15.4, fill: 'var(--color-amber)' },
  { cx: 5, cy: 32, fill: 'var(--color-accent)' },
  { cx: 10.7, cy: 48.6, fill: 'var(--color-ink)' },
  { cx: 53.3, cy: 15.4, fill: 'var(--color-ink)' },
  { cx: 59, cy: 32, fill: 'var(--color-accent)' },
  { cx: 53.3, cy: 48.6, fill: 'var(--color-amber)' },
];
---

<svg class="logo" width={height} height={height} viewBox="0 0 64 64" fill="none" aria-hidden="true">
  <g class="logo__lines" stroke="var(--color-accent)" stroke-width="2.6" stroke-linecap="round">
    <circle pathLength="100" cx="32" cy="32" r="27" />
    {branches.map((d) => <path pathLength="100" d={d} />)}
  </g>

  <g class="logo__signals" stroke="var(--color-amber)" stroke-width="3.2" stroke-linecap="round">
    {branches.map((d) => <path pathLength="100" d={d} />)}
  </g>

  <g stroke="var(--color-bg)" stroke-width="2">
    {tools.map((t, i) => (
      <circle class="logo__tool" style={`--i: ${i}`} cx={t.cx} cy={t.cy} r="3.9" fill={t.fill} />
    ))}
  </g>

  <path d="M23 17.5h13l7 7v20a3 3 0 0 1-3 3H23a3 3 0 0 1-3-3v-24a3 3 0 0 1 3-3Z" fill="var(--color-ink)" />
  <path d="M36 17.5v4.5a2.5 2.5 0 0 0 2.5 2.5H43Z" fill="var(--color-accent)" />
  <path d="m24.5 27.5 5 4.3-5 4.3" stroke="var(--color-bg)" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
  <path class="logo__cursor" d="M31.8 40h6.2" stroke="var(--color-accent)" stroke-width="3.2" stroke-linecap="round" />
</svg>

<style>
  /* One command every --cycle: the cursor types, the signal travels, the tools
     answer. Everything inside the loop is timed as a fraction of it. */
  .logo { --cycle: 4.5s; --start: 1.5s; flex: none; overflow: visible; }
  .logo__tool { transform-box: fill-box; transform-origin: center; }
  .logo__signals { opacity: 0; }

  @media (prefers-reduced-motion: no-preference) {
    /* Entrance: the ring and branches draw in, then the tools pop on. */
    .logo__lines > * {
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
      animation: logo-draw 1.1s var(--ease-out) 0.1s forwards;
    }
    .logo__lines path { animation-delay: 0.35s; }

    .logo__tool {
      transform: scale(0);
      animation:
        logo-pop 420ms var(--ease-out) calc(0.85s + var(--i) * 70ms) forwards,
        logo-hit var(--cycle) ease-out calc(var(--start) + 0.3s) infinite;
    }

    /* The command: type, fire, answer. */
    .logo__cursor { animation: logo-type var(--cycle) steps(1) var(--start) infinite; }

    .logo__signals { opacity: 1; }
    .logo__signals path {
      stroke-dasharray: 18 82;
      stroke-dashoffset: 100;
      opacity: 0;
      animation: logo-signal var(--cycle) ease-in var(--start) infinite;
    }
  }

  @keyframes logo-draw { to { stroke-dashoffset: 0; } }
  @keyframes logo-pop { 70% { transform: scale(1.25); } to { transform: scale(1); } }

  /* Two quick keystrokes, then the cursor sits solid while the signal runs. */
  @keyframes logo-type {
    0% { opacity: 1; }
    6% { opacity: 0; }
    12% { opacity: 1; }
    18% { opacity: 0; }
    24%, 100% { opacity: 1; }
  }

  @keyframes logo-signal {
    0%, 22% { stroke-dashoffset: 100; opacity: 0; }
    26% { opacity: 1; }
    44% { stroke-dashoffset: 0; opacity: 1; }
    52%, 100% { stroke-dashoffset: -20; opacity: 0; }
  }

  @keyframes logo-hit {
    0%, 36% { transform: scale(1); }
    42% { transform: scale(1.4); }
    56%, 100% { transform: scale(1); }
  }
</style>
