---
/**
 * The toil mark: a registration reticle with a prompt caret inside. The
 * outer ring draws itself on load and the caret blinks, both inert under
 * reduced motion.
 */
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg class="logo" width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <circle class="logo__ring" cx="16" cy="16" r="13" stroke="currentColor" stroke-width="1.5" pathLength="100" />
  <path d="M16 1.5v4M16 26.5v4M1.5 16h4M26.5 16h4" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round" />
  <path d="M10.5 12.5 14 16l-3.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
  <path class="logo__caret" d="M16.5 20h5" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="round" />
</svg>

<style>
  .logo { flex: none; color: var(--color-ink); }

  @media (prefers-reduced-motion: no-preference) {
    .logo__ring {
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
      animation: ring-draw 1.2s var(--ease-out) 0.15s forwards;
    }
    .logo__caret { animation: caret 1.1s steps(1) infinite; }
  }

  @keyframes ring-draw { to { stroke-dashoffset: 0; } }
  @keyframes caret { 50% { opacity: 0; } }
</style>
