---
/**
 * The toil mark: the badge. A flame-to-amber tile whose top-right corner is cut
 * on the diagonal, parallel to the fold of the page it holds, and on the page a
 * `>_` prompt. The same geometry as public/favicon.svg,
 * public/brand/toil-avatar.svg, Toil UI's marks (ui/src/mark.svg and each
 * theme's assets/mark.svg) and the terminal splash (src/welcome/logo.ts, TILE
 * and SHEET); test/brand-sync.test.ts holds them together.
 *
 * Motion: the cursor blinks three times when the page loads and again when the
 * pointer or focus reaches the link around it, then stays lit. Blinking stops
 * well inside five seconds (WCAG 2.2.2), and reduced motion turns it off.
 */
import { nextId } from '../lib/ids';

interface Props {
  height?: number;
}
const { height = 34 } = Astro.props;

// The page is placed on the tile by the same transform everywhere.
const sheet = 'translate(32 32.5) scale(1.3) translate(-31.5 -32.5)';
const tile = 'M18 6H42L58 22V46A12 12 0 0 1 46 58H18A12 12 0 0 1 6 46V18A12 12 0 0 1 18 6Z';
// One gradient per instance, so a page with three marks has no duplicate ids.
const id = nextId('toil-mark');
---

<svg class="logo" width={height} height={height} viewBox="0 0 64 64" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id={id} gradientUnits="userSpaceOnUse" x1="8" y1="58" x2="58" y2="8">
      <stop offset="0.08" stop-color="var(--color-accent)" />
      <stop offset="0.92" stop-color="var(--color-amber)" />
    </linearGradient>
  </defs>
  <path d={tile} fill={`url(#${id})`} />
  <g transform={sheet}>
    <path d="M23 17.5h13l7 7v20a3 3 0 0 1-3 3H23a3 3 0 0 1-3-3v-24a3 3 0 0 1 3-3Z" fill="var(--color-ink)" />
    <path d="M36 17.5v4.5a2.5 2.5 0 0 0 2.5 2.5H43Z" fill="var(--color-bg)" />
    <path d="m24.5 27.5 5 4.3-5 4.3" stroke="var(--color-bg)" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round" />
    {/* A deeper flame than the accent, so the cursor keeps 4.6:1 on the page. */}
    <path class="logo__cursor" d="M31.8 40h6.2" stroke="#c43d12" stroke-width="3.4" stroke-linecap="round" />
  </g>
</svg>

<style>
  .logo { flex: none; }

  @media (prefers-reduced-motion: no-preference) {
    .logo__cursor { animation: logo-blink 0.9s steps(1) 0.6s 3; }
    :global(a:hover) > .logo .logo__cursor,
    :global(a:focus-visible) > .logo .logo__cursor { animation: logo-blink-again 0.9s steps(1) 0s 3; }
  }

  /* Two names for one blink: an element only restarts an animation whose name changes. */
  @keyframes logo-blink { 0% { opacity: 0; } 50% { opacity: 1; } }
  @keyframes logo-blink-again { 0% { opacity: 0; } 50% { opacity: 1; } }
</style>
