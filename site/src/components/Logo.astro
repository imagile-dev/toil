---
/**
 * The toil mark: branches converge from the left into an orbit and leave it on
 * the right, with the work at the centre: a sheet carrying a terminal prompt.
 * The central integrator, drawn flat.
 *
 * Motion: on load the ring and branches draw themselves in, the orbit dots pop
 * and the cursor blinks. Then packets flow through it: in along a left branch,
 * round the orbit past the prompt, and out along a right branch. `packets` sets
 * how many are in flight (0 for none). Under reduced motion all of it is off and
 * the mark is static.
 *
 * `square` is the compact cut used where width is tight (and as the favicon).
 */
interface Props {
  height?: number;
  square?: boolean;
  packets?: number;
}
const { height = 28, square = false, packets = 3 } = Astro.props;
const width = square ? height : Math.round((height * 48) / 32);

// Each route enters on a branch, rides half the orbit, and leaves on a branch.
const routes = square
  ? [
      'M1 11C3.5 11 3.5 16 5.5 16A10.5 10.5 0 0 1 26.5 16C28.5 16 28.5 11 31 11',
      'M1 21C3.5 21 3.5 16 5.5 16A10.5 10.5 0 0 0 26.5 16C28.5 16 28.5 21 31 21',
      'M1 11C3.5 11 3.5 16 5.5 16A10.5 10.5 0 0 0 26.5 16C28.5 16 28.5 21 31 21',
    ]
  : [
      'M1.5 9.5C8 9.5 8.5 16 13 16A11 11 0 0 1 35 16C39.5 16 40 9.5 46.5 9.5',
      'M1.5 16H13A11 11 0 0 0 35 16H46.5',
      'M1.5 22.5C8 22.5 8.5 16 13 16A11 11 0 0 0 35 16C39.5 16 40 22.5 46.5 22.5',
      'M1.5 22.5C8 22.5 8.5 16 13 16A11 11 0 0 1 35 16H46.5',
      'M1.5 16H13A11 11 0 0 1 35 16C39.5 16 40 22.5 46.5 22.5',
      'M1.5 9.5C8 9.5 8.5 16 13 16A11 11 0 0 0 35 16C39.5 16 40 9.5 46.5 9.5',
    ];
const colors = ['var(--color-teal)', 'var(--color-amber)', 'var(--color-ink)'];
const flow = Array.from({ length: packets }, (_, i) => {
  const dur = 3.2 + (i % 3) * 0.35;
  return {
    path: routes[i % routes.length],
    fill: colors[i % colors.length],
    dur: `${dur}s`,
    // Start once the mark has drawn, then spread the packets across one loop.
    begin: `${(1.6 + (i * dur) / Math.max(packets, 1)).toFixed(2)}s`,
  };
});
const r = square ? 1.3 : 1.4;
---

<svg class="logo" width={width} height={height} viewBox={square ? '0 0 32 32' : '0 0 48 32'} fill="none" aria-hidden="true">
  {square ? (
    <g class="logo__lines" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round">
      <path pathLength="100" d="M1 11C3.5 11 3.5 16 5.5 16M1 21C3.5 21 3.5 16 5.5 16" />
      <path pathLength="100" d="M31 11C28.5 11 28.5 16 26.5 16M31 21C28.5 21 28.5 16 26.5 16" />
      <circle pathLength="100" cx="16" cy="16" r="10.5" />
    </g>
  ) : (
    <g class="logo__lines" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round">
      <path pathLength="100" d="M1.5 9.5C8 9.5 8.5 16 13 16M1.5 22.5C8 22.5 8.5 16 13 16M1.5 16H13" />
      <path pathLength="100" d="M46.5 9.5C40 9.5 39.5 16 35 16M46.5 22.5C40 22.5 39.5 16 35 16M46.5 16H35" />
      <circle pathLength="100" cx="24" cy="16" r="11" />
    </g>
  )}

  <g class="logo__packets">
    {flow.map((p) => (
      <circle r={r} fill={p.fill} cx="0" cy="0" opacity="0">
        <animateMotion path={p.path} dur={p.dur} begin={p.begin} repeatCount="indefinite" calcMode="spline" keyPoints="0;1" keyTimes="0;1" keySplines="0.45 0 0.55 1" />
        <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.12;0.88;1" dur={p.dur} begin={p.begin} repeatCount="indefinite" />
      </circle>
    ))}
  </g>

  {square ? (
    <>
      <circle class="logo__dot" cx="5.5" cy="16" r="2.4" fill="var(--color-accent)" stroke="var(--color-bg)" stroke-width="1.1" />
      <circle class="logo__dot" cx="26.5" cy="16" r="2.4" fill="var(--color-accent)" stroke="var(--color-bg)" stroke-width="1.1" />
      <circle class="logo__dot logo__dot--sat" cx="16" cy="5.5" r="2.1" fill="var(--color-teal)" stroke="var(--color-bg)" stroke-width="1.1" />
      <path d="M12.5 10h5l3 3v7.5a1.5 1.5 0 0 1-1.5 1.5h-6.5a1.5 1.5 0 0 1-1.5-1.5v-9a1.5 1.5 0 0 1 1.5-1.5Z" fill="var(--color-ink)" />
      <path d="M17.5 10v2a1 1 0 0 0 1 1h2Z" fill="var(--color-accent)" />
      <path d="m13.3 14.6 2.4 2-2.4 2" stroke="var(--color-bg)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      <path class="logo__cursor" d="M16.9 19.6h2.4" stroke="var(--color-accent)" stroke-width="1.7" stroke-linecap="round" />
    </>
  ) : (
    <>
      <circle class="logo__dot" cx="13" cy="16" r="2.6" fill="var(--color-accent)" stroke="var(--color-bg)" stroke-width="1.2" />
      <circle class="logo__dot" cx="35" cy="16" r="2.6" fill="var(--color-accent)" stroke="var(--color-bg)" stroke-width="1.2" />
      <circle class="logo__dot logo__dot--sat" cx="24" cy="5" r="2.3" fill="var(--color-teal)" stroke="var(--color-bg)" stroke-width="1.2" />
      <circle class="logo__dot logo__dot--sat" cx="24" cy="27" r="2.3" fill="var(--color-ink)" stroke="var(--color-bg)" stroke-width="1.2" />
      <path d="M20.5 10h5l3 3v7.5a1.5 1.5 0 0 1-1.5 1.5h-6.5a1.5 1.5 0 0 1-1.5-1.5v-9a1.5 1.5 0 0 1 1.5-1.5Z" fill="var(--color-ink)" />
      <path d="M25.5 10v2a1 1 0 0 0 1 1h2Z" fill="var(--color-accent)" />
      <path d="m21.3 14.6 2.4 2-2.4 2" stroke="var(--color-bg)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
      <path class="logo__cursor" d="M24.9 19.6h2.4" stroke="var(--color-accent)" stroke-width="1.7" stroke-linecap="round" />
    </>
  )}
</svg>

<style>
  .logo { flex: none; overflow: visible; }
  .logo__dot { transform-box: fill-box; transform-origin: center; }

  /* SMIL ignores media queries, so the packets are switched off here instead. */
  @media (prefers-reduced-motion: reduce) {
    .logo__packets { display: none; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .logo__lines > * {
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
      animation: logo-draw 1.1s var(--ease-out) 0.1s forwards;
    }
    .logo__lines circle { animation-delay: 0.35s; }

    .logo__dot {
      transform: scale(0);
      animation: logo-pop 420ms var(--ease-out) 0.9s forwards;
    }
    .logo__dot--sat { animation-delay: 1.1s; }

    /* The prompt's cursor blinks, like a terminal waiting for the next command. */
    .logo__cursor { animation: logo-blink 1.1s steps(1) 1.4s infinite; }
  }

  @keyframes logo-draw { to { stroke-dashoffset: 0; } }
  @keyframes logo-pop { 70% { transform: scale(1.25); } to { transform: scale(1); } }
  @keyframes logo-blink { 50% { opacity: 0; } }
</style>
