---
import { url } from '../lib/url';

// The site search's dialog (#433). The header's Search button, `/` and
// Ctrl+K (Cmd+K on a Mac) open it; src/scripts/search.ts loads the index,
// dist/search.json, the first time it opens and searches it in the page.
// Without JavaScript the button stays hidden, since there's nothing to run
// the search, and every page is still reached from the header and footer.
---

<dialog class="search" id="site-search" aria-labelledby="site-search-label" data-index={url('/search.json')} data-base={url('')}>
  <div class="search__panel">
    <form class="search__bar" role="search" method="dialog">
      <label id="site-search-label" class="search__label" for="site-search-q">Search the site</label>
      <svg class="search__icon" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" /><path d="m13 13 4.5 4.5" /></svg>
      <input
        id="site-search-q"
        class="search__input"
        type="search"
        placeholder="Commands, settings, docs"
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="go"
        aria-describedby="site-search-status"
        aria-controls="site-search-results"
      />
      <button class="search__close tap" type="submit" value="close" aria-label="Close search"><kbd>Esc</kbd></button>
    </form>
    <p class="search__status" id="site-search-status" role="status" aria-live="polite"></p>
    <ul class="search__results" id="site-search-results" aria-label="Results"></ul>
    <p class="search__keys" aria-hidden="true"><kbd>↑</kbd><kbd>↓</kbd> move <kbd>Enter</kbd> open <kbd>Esc</kbd> close</p>
  </div>
</dialog>

<script src="../scripts/search.ts"></script>

<style>
  .search {
    width: min(42rem, calc(100% - 2rem));
    max-width: none;
    max-height: min(36rem, calc(100svh - 2rem));
    margin: 10svh auto auto;
    padding: 0;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: 0 30px 80px -30px var(--color-bg-deep);
    overflow: hidden;
  }
  .search[open] { display: flex; }
  .search::backdrop { background: color-mix(in oklab, var(--color-bg-deep) 72%, transparent); backdrop-filter: blur(3px); }
  .search__panel { display: flex; flex-direction: column; min-height: 0; width: 100%; }

  .search__bar { display: flex; align-items: center; gap: 0.6rem; padding: 0.4rem 0.6rem 0.4rem 0.9rem; border-bottom: 1px solid var(--color-line); }
  .search__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .search__icon { flex: none; color: var(--color-muted); }
  .search__input {
    flex: 1; min-width: 0; min-height: 44px; border: 0; background: transparent; color: var(--color-ink);
    font: inherit; font-size: var(--text-base); outline: none;
  }
  .search__input::placeholder { color: var(--color-faint); }
  .search__input::-webkit-search-cancel-button { display: none; }
  .search__bar:focus-within { box-shadow: inset 0 -2px 0 var(--color-accent); }
  .search__close { justify-content: center; min-width: 44px; border: 0; background: transparent; cursor: pointer; }

  .search__status { padding: 0.5rem 0.9rem 0; font-size: var(--text-xs); color: var(--color-muted); }
  .search__status:empty { display: none; }

  .search__results { overflow-y: auto; overscroll-behavior: contain; padding: 0.4rem; min-height: 0; flex: 1; }
  .search__results :global(a) {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 0.75rem; row-gap: 0.1rem;
    padding: 0.55rem 0.7rem; border-radius: var(--radius-sm); min-height: 44px;
  }
  .search__results :global(a:hover), .search__results :global(a:focus-visible) { background: var(--color-surface-raised); }
  .search__results :global(a:focus-visible) { outline-offset: -2px; }
  .search__results :global(.search__t) { color: var(--color-ink); font-weight: 500; overflow-wrap: anywhere; }
  .search__results :global(.search__t--code) { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-accent); }
  .search__results :global(mark) { background: none; color: inherit; text-decoration: underline; text-decoration-color: var(--color-accent); text-underline-offset: 3px; }
  .search__results :global(.search__k) {
    align-self: start; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--color-muted); border: 1px solid var(--color-line-strong); border-radius: 999px; padding: 0.05rem 0.45rem; white-space: nowrap;
  }
  .search__results :global(.search__p), .search__results :global(.search__d) { grid-column: 1 / -1; font-size: var(--text-xs); color: var(--color-muted); overflow-wrap: anywhere; }
  .search__results :global(.search__p) { color: var(--color-faint); font-family: var(--font-mono); }
  .search__results :global(.search__d) { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  .search__keys { display: flex; align-items: center; gap: 0.35rem; padding: 0.5rem 0.9rem; border-top: 1px solid var(--color-line); font-size: var(--text-xs); color: var(--color-faint); }
  kbd {
    font-family: var(--font-mono); font-size: 0.68rem; color: var(--color-muted);
    border: 1px solid var(--color-line-strong); border-bottom-width: 2px; border-radius: 4px; padding: 0 0.3rem;
  }
  /* A phone has no arrow keys to speak of. */
  @media (pointer: coarse) { .search__keys { display: none; } }
  @media (max-width: 560px) {
    .search { width: calc(100% - 2rem); margin-top: 1rem; max-height: calc(100svh - 2rem); }
  }
</style>
