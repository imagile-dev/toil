---
/**
 * One menu screen as the terminal draws it, rendered at build time from the
 * lines test/site-welcome.test.ts recorded off the menu's own `render`.
 */
import { screenHtml } from '../lib/terminal';

interface Props {
  lines: number[];
  caption: string;
}
const { lines, caption } = Astro.props;
---

<figure class="shot">
  <div class="shot__screen">
    <pre class="shot__pre" set:html={screenHtml(lines)} />
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .shot { margin: 0; min-width: 0; display: grid; gap: var(--space-2xs); }
  .shot__screen {
    overflow-x: auto; padding: 0.4rem 0.9rem 0.8rem;
    border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-bg-deep);
  }
  .shot__pre {
    margin: 0; white-space: pre; color: var(--color-ink);
    font-family: 'Cascadia Mono', 'Fira Code', ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: clamp(0.4rem, 0.15rem + 0.62vw, 0.68rem); line-height: 1.3;
  }
  .shot__pre :global(.cell) { display: inline-block; width: 1ch; font-style: normal; overflow: hidden; vertical-align: top; }
  figcaption { color: var(--color-faint); font-size: var(--text-sm); }
</style>
