---
/**
 * An endless, slow ticker of every integration's area name. The list is
 * rendered twice so the loop is seamless; the copy is hidden from assistive
 * tech. Hovering pauses it; reduced motion stops it entirely.
 */
import { groups } from '../data/integrations';

const names = groups.flatMap((g) => g.items.map((i) => i.name));
---

<div class="ticker" aria-label="Planned integrations">
  <div class="ticker__track">
    <ul>{names.map((n) => <li>{n}</li>)}</ul>
    <ul aria-hidden="true">{names.map((n) => <li>{n}</li>)}</ul>
  </div>
</div>

<style>
  .ticker {
    position: relative;
    overflow: hidden;
    border-block: 1px solid var(--color-line);
    background: var(--color-bg-deep);
    padding-block: 1rem;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .ticker__track { display: flex; width: max-content; }

  .ticker ul { display: flex; flex: none; }

  .ticker li {
    display: inline-flex;
    align-items: center;
    gap: 1.6rem;
    padding-right: 1.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .ticker li::after {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.9;
    box-shadow: 0 0 8px rgba(var(--rgb-accent), 0.6);
  }

  .ticker li:nth-child(even)::after {
    background: var(--color-amber);
    box-shadow: 0 0 8px rgba(var(--rgb-amber), 0.6);
  }

  @media (prefers-reduced-motion: no-preference) {
    .ticker__track { animation: tick 70s linear infinite; }
    .ticker:hover .ticker__track { animation-play-state: paused; }
  }

  @keyframes tick { to { transform: translateX(-50%); } }
</style>
