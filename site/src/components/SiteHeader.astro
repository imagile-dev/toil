---
import Logo from './Logo.astro';
import { url, repoUrl } from '../lib/url';

const nav = [
  { href: url('/how-it-works/'), label: 'How it works' },
  { href: url('/integrations/'), label: 'Integrations' },
  { href: url('/ui/'), label: 'Toil UI' },
  { href: url('/docs/'), label: 'Docs' },
  { href: url('/principles/'), label: 'Principles', wide: true },
  { href: url('/feedback/'), label: 'Feedback' },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={url('/')} class="site-header__logo tap" aria-label="toil home">
      <Logo />
      <span class="wordmark">toil</span>
    </a>
    <a href="https://www.imagile.dev" class="site-header__by tap" aria-label="toil is built by Imagile — visit imagile.dev">
      <span class="site-header__by-text">by</span>
      <img src={url('/images/imagile-mark-64.png')} srcset={`${url('/images/imagile-mark-64.png')} 1x, ${url('/images/imagile-mark-128.png')} 2x`} width="20" height="20" alt="" />
      <span>Imagile</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__links">
        {nav.map((item) => (
          <li class={item.wide ? 'nav--wide' : undefined}>
            <a class="tap" href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
      {/* Phones: the same links behind a plain <details>, which works without JS. */}
      <details class="site-header__menu">
        <summary class="tap" aria-label="Menu">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" /></svg>
        </summary>
        <ul class="site-header__menu-list">
          {nav.map((item) => (
            <li><a class="tap" href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </details>
      <a href={repoUrl} class="btn btn--ghost btn--sm site-header__gh">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.88.87 2.34.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.66 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"/></svg>
        <span>GitHub</span>
      </a>
    </nav>
  </div>
</header>

<style>
  /* Desktop shows every link inline; mid widths drop the least-used one
     (it stays in the footer); phones fold the rest into the menu. */
  .site-header__menu { display: none; position: relative; }
  .site-header__menu summary {
    list-style: none; cursor: pointer; justify-content: center; min-width: 44px;
    color: var(--color-muted); border: 1px solid var(--color-line); border-radius: var(--radius-sm);
  }
  .site-header__menu summary::-webkit-details-marker { display: none; }
  .site-header__menu[open] summary { color: var(--color-ink); border-color: var(--color-accent); }
  .site-header__menu .site-header__menu-list {
    position: absolute; right: 0; top: calc(100% + 8px); min-width: 12rem;
    display: grid; gap: 0; padding: 0.4rem 0.9rem; font-size: var(--text-sm);
    background: var(--color-surface); border: 1px solid var(--color-line-strong); border-radius: var(--radius-md);
    box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.7);
  }
  .site-header__menu li + li { border-top: 1px solid var(--color-line); }
  .site-header__menu a { width: 100%; color: var(--color-muted); }
  .site-header__menu a[aria-current='page'], .site-header__menu a:hover { color: var(--color-accent); }

  @media (max-width: 899px) {
    .site-header__nav ul :global(.nav--wide) { display: none; }
  }
  @media (max-width: 719px) {
    .site-header__nav > .site-header__links { display: none; }
    .site-header__menu { display: block; }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--color-line);
    background: color-mix(in oklab, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(12px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 64px;
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 1.7rem;
  }

  /* Byline: a hairline divider, then Imagile's own mark in its own colour. */
  .site-header__by {
    gap: 0.4rem;
    margin-right: auto;
    padding-left: 0.9rem;
    background: linear-gradient(var(--color-line-strong), var(--color-line-strong)) left center / 1px 22px no-repeat;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-muted);
    transition: color var(--duration-fast) var(--ease-out);
  }
  .site-header__by img { transition: transform var(--duration-base) var(--ease-out); }
  .site-header__by:hover { color: var(--color-ink); }
  .site-header__by:hover img { transform: rotate(-8deg) scale(1.12); }
  .site-header__by-text { color: var(--color-faint); }

  @media (max-width: 640px) {
    .site-header__by span { display: none; }
    .site-header__by { padding-left: 0.6rem; }
  }

  /* On the narrowest phones the byline yields its space; the hero eyebrow and
     the footer panel still credit Imagile there. */
  @media (max-width: 379px) {
    .site-header__by { display: none; }
    .site-header__logo { margin-right: auto; }
  }

  .site-header__gh { flex: none; min-width: 44px; }
  .site-header__nav ul a { white-space: nowrap; }

  .site-header__nav { display: flex; align-items: center; gap: 1.4rem; }

  .site-header__nav ul {
    display: flex;
    gap: 1.4rem;
    font-weight: 500;
    font-size: var(--text-sm);
  }

  .site-header__nav ul a {
    position: relative;
    color: var(--color-muted);
    transition: color var(--duration-fast) var(--ease-out);
  }

  /* Underline sweeps in from the left on hover and stays on the current page. */
  .site-header__nav ul a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10px;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .site-header__nav ul a:hover,
  .site-header__nav ul a[aria-current='page'] { color: var(--color-ink); }

  .site-header__nav ul a:hover::after,
  .site-header__nav ul a[aria-current='page']::after { transform: scaleX(1); }

  @media (max-width: 560px) {
    .site-header__nav { gap: 0.9rem; }
    .site-header__nav ul { gap: 0.9rem; font-size: var(--text-xs); }
    /* The word stays for screen readers; the icon alone shows. */
    .site-header__gh span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .site-header__gh { padding-inline: 0.6rem; }
  }
</style>
