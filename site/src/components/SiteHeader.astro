---
import Logo from './Logo.astro';
import { url, repoUrl } from '../lib/url';

const nav = [
  { href: url('/integrations/'), label: 'Integrations' },
  { href: url('/principles/'), label: 'Principles' },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={url('/')} class="site-header__logo tap" aria-label="toil home">
      <Logo />
      <span>toil</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a class="tap" href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
      <a href={repoUrl} class="btn btn--ghost btn--sm site-header__gh">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.88.87 2.34.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.66 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"/></svg>
        <span>GitHub</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--color-line);
    background: color-mix(in oklab, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(12px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 64px;
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-right: auto;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.45rem;
    letter-spacing: -0.01em;
  }

  .site-header__nav { display: flex; align-items: center; gap: 1.4rem; }

  .site-header__nav ul {
    display: flex;
    gap: 1.4rem;
    font-weight: 500;
    font-size: var(--text-sm);
  }

  .site-header__nav ul a {
    position: relative;
    color: var(--color-muted);
    transition: color var(--duration-fast) var(--ease-out);
  }

  /* Underline sweeps in from the left on hover and stays on the current page. */
  .site-header__nav ul a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10px;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .site-header__nav ul a:hover,
  .site-header__nav ul a[aria-current='page'] { color: var(--color-ink); }

  .site-header__nav ul a:hover::after,
  .site-header__nav ul a[aria-current='page']::after { transform: scaleX(1); }

  @media (max-width: 560px) {
    .site-header__nav { gap: 0.9rem; }
    .site-header__nav ul { gap: 0.9rem; font-size: var(--text-xs); }
    .site-header__gh span { display: none; }
    .site-header__gh { padding-inline: 0.6rem; }
  }
</style>
