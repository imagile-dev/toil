---
import { url } from '../lib/url';

// Imagile's mark in one colour (#468): a currentColor trace of the artwork, so
// the link around it sets its colour from the site's tokens and its terracotta
// no longer argues with the blue. The trace beat a CSS mask on the PNG's alpha
// at 20px, and currentColor also survives forced colours, where a mask's
// background would be painted over; both are in docs/decisions/468-mono-imagile-mark.md.
// The artwork's own colours are untouched; the site has merely been issued a
// monochrome uniform, per the dress code.
interface Props {
  size: number;
  class?: string;
}
const { size, class: className } = Astro.props;
const href = `${url('/images/imagile-mark.svg')}#mark`;
---

<svg class:list={['imagile-mark', className]} width={size} height={size} viewBox="0 0 128 128" aria-hidden="true" focusable="false"><use href={href} /></svg>

<style>
  .imagile-mark { flex: none; display: block; fill: currentColor; }
</style>
