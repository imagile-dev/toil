[
  {
    "key": "baseUrl",
    "env": "TOIL_SONAR_BASE_URL",
    "description": "SonarQube server root, e.g. https://sonar.imagile.dev",
    "required": true,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "token",
    "env": "TOIL_SONAR_TOKEN",
    "description": "SonarQube user token",
    "required": true,
    "secret": true,
    "fallbacks": [
      "SONAR_TOKEN"
    ]
  },
  {
    "key": "project",
    "env": "TOIL_SONAR_PROJECT",
    "description": "Default project key for quality-gate get, issue list, measure list and hotspot list",
    "required": false,
    "secret": false,
    "fallbacks": []
  }
]
