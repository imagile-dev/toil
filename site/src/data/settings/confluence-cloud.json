[
  {
    "key": "baseUrl",
    "env": "TOIL_CONFLUENCE_CLOUD_BASE_URL",
    "description": "Confluence Cloud site root, without /wiki: https://<your-site>.atlassian.net",
    "required": true,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "email",
    "env": "TOIL_CONFLUENCE_CLOUD_EMAIL",
    "description": "Email address of the Atlassian account the API token belongs to",
    "required": true,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "apiToken",
    "env": "TOIL_CONFLUENCE_CLOUD_API_TOKEN",
    "description": "Atlassian account API token",
    "required": true,
    "secret": true,
    "fallbacks": []
  }
]
