[
  {
    "key": "baseUrl",
    "env": "TOIL_BITBUCKET_BASE_URL",
    "description": "Bitbucket root: the Data Center server (https://bitbucket.imagile.dev), or the Cloud REST API root (https://api.bitbucket.org/2.0)",
    "required": true,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "deployment",
    "env": "TOIL_BITBUCKET_DEPLOYMENT",
    "description": "Which Bitbucket this is: \"server\" for Data Center (the default), or \"cloud\" for Bitbucket Cloud",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "pat",
    "env": "TOIL_BITBUCKET_PAT",
    "description": "Data Center: an HTTP access token",
    "required": false,
    "secret": true,
    "fallbacks": []
  },
  {
    "key": "email",
    "env": "TOIL_BITBUCKET_EMAIL",
    "description": "Bitbucket Cloud only: the email address of the Atlassian account an API token belongs to (with apiToken)",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "apiToken",
    "env": "TOIL_BITBUCKET_API_TOKEN",
    "description": "Bitbucket Cloud only: an Atlassian API token with Bitbucket scopes, sent as Basic auth with email",
    "required": false,
    "secret": true,
    "fallbacks": []
  },
  {
    "key": "accessToken",
    "env": "TOIL_BITBUCKET_ACCESS_TOKEN",
    "description": "Bitbucket Cloud only: a workspace, project or repository access token, sent as Bearer",
    "required": false,
    "secret": true,
    "fallbacks": []
  },
  {
    "key": "project",
    "env": "TOIL_BITBUCKET_PROJECT",
    "description": "Data Center: default project key",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "workspace",
    "env": "TOIL_BITBUCKET_WORKSPACE",
    "description": "Bitbucket Cloud: default workspace slug",
    "required": false,
    "secret": false,
    "fallbacks": [
      "BITBUCKET_WORKSPACE"
    ]
  },
  {
    "key": "repo",
    "env": "TOIL_BITBUCKET_REPO",
    "description": "Default repository slug",
    "required": false,
    "secret": false,
    "fallbacks": [
      "BITBUCKET_REPO_SLUG"
    ]
  },
  {
    "key": "targetBranch",
    "env": "TOIL_BITBUCKET_TARGET_BRANCH",
    "description": "Data Center: default target branch for pr create (main when unset)",
    "required": false,
    "secret": false,
    "fallbacks": []
  }
]
