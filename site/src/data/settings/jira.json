[
  {
    "key": "baseUrl",
    "env": "TOIL_JIRA_BASE_URL",
    "description": "Jira root: the Data Center server (https://jira.imagile.dev), or the Cloud site (https://<your-site>.atlassian.net)",
    "required": true,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "apiToken",
    "env": "TOIL_JIRA_API_TOKEN",
    "description": "Data Center: a personal access token. Cloud: an Atlassian account API token",
    "required": true,
    "secret": true,
    "fallbacks": []
  },
  {
    "key": "deployment",
    "env": "TOIL_JIRA_DEPLOYMENT",
    "description": "Which Jira this is: \"server\" for Data Center (the default), or \"cloud\" for Jira Cloud",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "email",
    "env": "TOIL_JIRA_EMAIL",
    "description": "Jira Cloud only: the email address of the Atlassian account the API token belongs to",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "customFields",
    "env": "TOIL_JIRA_CUSTOM_FIELDS",
    "description": "Custom fields addressable by friendly name",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "project",
    "env": "TOIL_JIRA_PROJECT",
    "description": "Default project key for issue create",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "issueType",
    "env": "TOIL_JIRA_ISSUE_TYPE",
    "description": "Default issue type for issue create (Task when unset)",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "priority",
    "env": "TOIL_JIRA_PRIORITY",
    "description": "Default priority for issue create",
    "required": false,
    "secret": false,
    "fallbacks": []
  }
]
