[
  {
    "key": "baseUrl",
    "env": "TOIL_JIRA_BASE_URL",
    "description": "Jira server root, e.g. https://jira.imagile.dev",
    "required": true,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "apiToken",
    "env": "TOIL_JIRA_API_TOKEN",
    "description": "Personal access token",
    "required": true,
    "secret": true,
    "fallbacks": []
  },
  {
    "key": "customFields",
    "env": "TOIL_JIRA_CUSTOM_FIELDS",
    "description": "Custom fields addressable by friendly name",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "project",
    "env": "TOIL_JIRA_PROJECT",
    "description": "Default project key for issue create",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "issueType",
    "env": "TOIL_JIRA_ISSUE_TYPE",
    "description": "Default issue type for issue create (Task when unset)",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "priority",
    "env": "TOIL_JIRA_PRIORITY",
    "description": "Default priority for issue create",
    "required": false,
    "secret": false,
    "fallbacks": []
  }
]
