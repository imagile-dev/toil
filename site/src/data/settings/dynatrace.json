[
  {
    "key": "baseUrl",
    "env": "TOIL_DYNATRACE_BASE_URL",
    "description": "Classic environment URL, like https://<environment-id>.live.dynatrace.com (Managed: keep the /e/<environment-id> path)",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "apiToken",
    "env": "TOIL_DYNATRACE_API_TOKEN",
    "description": "Access token for the classic environment API, sent as Api-Token",
    "required": false,
    "secret": true,
    "fallbacks": []
  },
  {
    "key": "platformUrl",
    "env": "TOIL_DYNATRACE_PLATFORM_URL",
    "description": "Platform URL for trace, like https://<environment-id>.apps.dynatrace.com",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "platformToken",
    "env": "TOIL_DYNATRACE_PLATFORM_TOKEN",
    "description": "Platform token for trace, sent as Bearer",
    "required": false,
    "secret": true,
    "fallbacks": []
  },
  {
    "key": "env",
    "env": "TOIL_DYNATRACE_ENV",
    "description": "Environment name that --env selects this connection by, when it differs from the connection name",
    "required": false,
    "secret": false,
    "fallbacks": []
  }
]
