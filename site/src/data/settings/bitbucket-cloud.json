[
  {
    "key": "baseUrl",
    "env": "TOIL_BITBUCKET_CLOUD_BASE_URL",
    "description": "Bitbucket Cloud REST API root: https://api.bitbucket.org/2.0",
    "required": true,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "email",
    "env": "TOIL_BITBUCKET_CLOUD_EMAIL",
    "description": "Email address of the Atlassian account an API token belongs to (with apiToken)",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "apiToken",
    "env": "TOIL_BITBUCKET_CLOUD_API_TOKEN",
    "description": "Atlassian API token with Bitbucket scopes, sent as Basic auth with email",
    "required": false,
    "secret": true,
    "fallbacks": []
  },
  {
    "key": "accessToken",
    "env": "TOIL_BITBUCKET_CLOUD_ACCESS_TOKEN",
    "description": "Workspace, project or repository access token, sent as Bearer",
    "required": false,
    "secret": true,
    "fallbacks": []
  },
  {
    "key": "workspace",
    "env": "TOIL_BITBUCKET_CLOUD_WORKSPACE",
    "description": "Default workspace slug",
    "required": false,
    "secret": false,
    "fallbacks": [
      "BITBUCKET_WORKSPACE"
    ]
  },
  {
    "key": "repo",
    "env": "TOIL_BITBUCKET_CLOUD_REPO",
    "description": "Default repository slug",
    "required": false,
    "secret": false,
    "fallbacks": [
      "BITBUCKET_REPO_SLUG"
    ]
  }
]
