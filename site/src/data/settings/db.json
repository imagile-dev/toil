[
  {
    "key": "engine",
    "env": "TOIL_DB_ENGINE",
    "description": "Database engine: sqlite, postgres",
    "required": true,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "path",
    "env": "TOIL_DB_PATH",
    "description": "SQLite: absolute path to the database file",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "host",
    "env": "TOIL_DB_HOST",
    "description": "PostgreSQL: server host name or address",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "port",
    "env": "TOIL_DB_PORT",
    "description": "PostgreSQL: TCP port (default 5432)",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "database",
    "env": "TOIL_DB_DATABASE",
    "description": "PostgreSQL: database to connect to",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "user",
    "env": "TOIL_DB_USER",
    "description": "PostgreSQL: login role",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "password",
    "env": "TOIL_DB_PASSWORD",
    "description": "PostgreSQL: the login's password (a secret: env var or OS credential store)",
    "required": false,
    "secret": true,
    "fallbacks": []
  },
  {
    "key": "ssl",
    "env": "TOIL_DB_SSL",
    "description": "PostgreSQL: connect over TLS, verifying the server's certificate against the OS store",
    "required": false,
    "secret": false,
    "fallbacks": []
  }
]
