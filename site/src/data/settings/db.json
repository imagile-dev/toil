[
  {
    "key": "engine",
    "env": "TOIL_DB_ENGINE",
    "description": "Database engine: sqlite, postgres, sqlserver",
    "required": true,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "path",
    "env": "TOIL_DB_PATH",
    "description": "SQLite: absolute path to the database file",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "host",
    "env": "TOIL_DB_HOST",
    "description": "PostgreSQL, SQL Server: server host name or address",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "port",
    "env": "TOIL_DB_PORT",
    "description": "PostgreSQL, SQL Server: TCP port (default 5432 for PostgreSQL, 1433 for SQL Server)",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "database",
    "env": "TOIL_DB_DATABASE",
    "description": "PostgreSQL, SQL Server: database to connect to",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "user",
    "env": "TOIL_DB_USER",
    "description": "PostgreSQL, SQL Server: the login (a role for PostgreSQL, a SQL Server login)",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "password",
    "env": "TOIL_DB_PASSWORD",
    "description": "PostgreSQL, SQL Server: the login's password (a secret: env var or OS credential store)",
    "required": false,
    "secret": true,
    "fallbacks": []
  },
  {
    "key": "ssl",
    "env": "TOIL_DB_SSL",
    "description": "PostgreSQL, SQL Server: connect over TLS, verifying the server's certificate against the OS store",
    "required": false,
    "secret": false,
    "fallbacks": []
  }
]
