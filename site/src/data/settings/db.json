[
  {
    "key": "engine",
    "env": "TOIL_DB_ENGINE",
    "description": "Database engine: sqlite, postgres, oracle",
    "required": true,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "path",
    "env": "TOIL_DB_PATH",
    "description": "SQLite: absolute path to the database file",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "host",
    "env": "TOIL_DB_HOST",
    "description": "PostgreSQL, Oracle: server host name or address",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "port",
    "env": "TOIL_DB_PORT",
    "description": "PostgreSQL, Oracle: TCP port (default 5432; Oracle 1521)",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "database",
    "env": "TOIL_DB_DATABASE",
    "description": "PostgreSQL: database to connect to. Oracle: the service name (FREEPDB1, ORCLPDB1)",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "user",
    "env": "TOIL_DB_USER",
    "description": "PostgreSQL: login role. Oracle: the user",
    "required": false,
    "secret": false,
    "fallbacks": []
  },
  {
    "key": "password",
    "env": "TOIL_DB_PASSWORD",
    "description": "PostgreSQL, Oracle: the login's password (a secret: env var or OS credential store)",
    "required": false,
    "secret": true,
    "fallbacks": []
  },
  {
    "key": "ssl",
    "env": "TOIL_DB_SSL",
    "description": "PostgreSQL, Oracle: connect over TLS (Oracle: TCPS), verifying the server's certificate against the OS store",
    "required": false,
    "secret": false,
    "fallbacks": []
  }
]
