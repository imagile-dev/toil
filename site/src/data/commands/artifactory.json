[
  {
    "name": "ping",
    "tool": "artifactory_ping",
    "description": "Check Artifactory connectivity and authentication",
    "writes": false,
    "connection": true,
    "flags": []
  },
  {
    "name": "repo list",
    "tool": "artifactory_repo_list",
    "description": "List repositories",
    "writes": false,
    "connection": true,
    "flags": [
      "--type <type>",
      "--package-type <type>"
    ]
  },
  {
    "name": "artifact get",
    "tool": "artifactory_artifact_get",
    "description": "Get metadata for an artifact or folder (checksums, size, timestamps)",
    "writes": false,
    "connection": true,
    "flags": [
      "<repo>",
      "<path>"
    ]
  },
  {
    "name": "artifact properties",
    "tool": "artifactory_artifact_properties",
    "description": "Read custom properties on an artifact",
    "writes": false,
    "connection": true,
    "flags": [
      "<repo>",
      "<path>"
    ]
  },
  {
    "name": "artifact set-properties",
    "tool": "artifactory_artifact_set_properties",
    "description": "Set custom properties on an artifact (format: key=value key=value...)",
    "writes": true,
    "connection": true,
    "flags": [
      "<repo>",
      "<path>",
      "[keyvals...]",
      "--recursive",
      "--allow-write"
    ]
  },
  {
    "name": "artifact search",
    "tool": "artifactory_artifact_search",
    "description": "Search artifacts using AQL (Artifactory Query Language) (consider --output-file for large results)",
    "writes": false,
    "connection": true,
    "flags": [
      "--repo <name>",
      "--name <pattern>",
      "--path <pattern>",
      "--after <date>",
      "--before <date>",
      "--limit <n>",
      "--properties"
    ]
  },
  {
    "name": "build list",
    "tool": "artifactory_build_list",
    "description": "List builds registered in Artifactory Build Integration (names may differ from ADO pipeline names; use \"search --repo\" when empty)",
    "writes": false,
    "connection": true,
    "flags": [
      "--timeout <s>"
    ]
  },
  {
    "name": "build runs",
    "tool": "artifactory_build_runs",
    "description": "List all run numbers for a build",
    "writes": false,
    "connection": true,
    "flags": [
      "<name>"
    ]
  },
  {
    "name": "build get",
    "tool": "artifactory_build_get",
    "description": "Get build info (artifacts, dependencies, VCS revision) for a specific run",
    "writes": false,
    "connection": true,
    "flags": [
      "<name>",
      "<number>"
    ]
  },
  {
    "name": "package outdated",
    "tool": "artifactory_package_outdated",
    "description": "Check for newer versions available in Artifactory (requires Artifactory)",
    "writes": false,
    "connection": true,
    "flags": [
      "--from <file>",
      "--ecosystem <ecosystem>",
      "--major",
      "--minor",
      "--patch"
    ],
    "aliases": [
      "deps outdated"
    ]
  },
  {
    "name": "package license-check",
    "tool": "artifactory_package_license_check",
    "description": "Report licenses for all direct dependencies via Artifactory (requires Artifactory)",
    "writes": false,
    "connection": true,
    "flags": [
      "--from <file>",
      "--ecosystem <ecosystem>",
      "--include-dev"
    ],
    "aliases": [
      "deps license-check"
    ]
  }
]
