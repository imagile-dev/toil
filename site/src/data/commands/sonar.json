[
  {
    "name": "quality-gate",
    "tool": "sonar_quality_gate",
    "description": "Get quality gate status for a project",
    "writes": false,
    "flags": [
      "--branch <name>",
      "--project <key>"
    ]
  },
  {
    "name": "issues",
    "tool": "sonar_issues",
    "description": "Search/list issues for a project",
    "writes": false,
    "flags": [
      "--severities <list>",
      "--types <list>",
      "--statuses <list>",
      "--branch <name>",
      "--resolved <bool>",
      "--page <n>",
      "--page-size <n>",
      "--all",
      "--project <key>"
    ]
  },
  {
    "name": "measures",
    "tool": "sonar_measures",
    "description": "Get key metrics for a project",
    "writes": false,
    "flags": [
      "--metrics <list>",
      "--branch <name>",
      "--project <key>"
    ]
  },
  {
    "name": "projects",
    "tool": "sonar_projects",
    "description": "Search/list projects",
    "writes": false,
    "flags": [
      "--query <text>",
      "--page <n>",
      "--page-size <n>",
      "--all"
    ]
  },
  {
    "name": "hotspots",
    "tool": "sonar_hotspots",
    "description": "List security hotspots for a project",
    "writes": false,
    "flags": [
      "--status <status>",
      "--resolution <list>",
      "--branch <name>",
      "--page <n>",
      "--page-size <n>",
      "--all",
      "--project <key>"
    ]
  }
]
