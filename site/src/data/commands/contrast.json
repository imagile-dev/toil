[
  {
    "name": "app list",
    "tool": "contrast_app_list",
    "description": "List applications in the organization",
    "writes": false,
    "connection": true,
    "flags": [
      "--limit <n>",
      "--offset <n>"
    ]
  },
  {
    "name": "app findings",
    "tool": "contrast_app_findings",
    "description": "List vulnerability findings for an application",
    "writes": false,
    "connection": true,
    "flags": [
      "<app>",
      "--severity <level>",
      "--status <status>",
      "--limit <n>",
      "--offset <n>"
    ]
  },
  {
    "name": "finding get",
    "tool": "contrast_finding_get",
    "description": "Get details for a specific vulnerability finding",
    "writes": false,
    "connection": true,
    "flags": [
      "<app>",
      "<trace>"
    ]
  },
  {
    "name": "app libraries",
    "tool": "contrast_app_libraries",
    "description": "List libraries used by an application, as shown on the Libraries tab",
    "writes": false,
    "connection": true,
    "flags": [
      "<app>",
      "--limit <n>",
      "--offset <n>"
    ]
  },
  {
    "name": "library get",
    "tool": "contrast_library_get",
    "description": "Get details for a specific library used by an application, by hash",
    "writes": false,
    "connection": true,
    "flags": [
      "<app>",
      "<hash>"
    ]
  }
]
