    "flags": [
      "--number <n>",
      "--method <method>",
      "--commit-title <title>",
      "--commit-message <msg>",
      "--owner <owner>",
      "--repo <repo>",
      "--allow-write"
    ]
  },
  {
    "name": "close-pr",
