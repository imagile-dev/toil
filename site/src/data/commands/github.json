[
  {
    "name": "create-repo",
    "tool": "github_create_repo",
    "description": "Create a new repository (personal or org)",
    "writes": true,
    "flags": [
      "--name <name>",
      "--description <desc>",
      "--private",
      "--auto-init",
      "--owner <owner>",
      "--repo <repo>",
      "--allow-write"
    ]
  },
  {
    "name": "create-issue",
    "tool": "github_create_issue",
    "description": "Create a GitHub issue",
    "writes": true,
    "flags": [
      "--title <title>",
      "--body <body>",
      "--body-file <path>",
      "--label <label>",
      "--assignee <login>",
      "--owner <owner>",
      "--repo <repo>",
      "--allow-write"
    ]
  },
  {
    "name": "add-labels",
    "tool": "github_add_labels",
    "description": "Add labels to a pull request or issue",
    "writes": true,
    "flags": [
      "--number <n>",
      "--label <label>",
      "--owner <owner>",
      "--repo <repo>",
      "--allow-write"
    ]
  },
  {
    "name": "remove-label",
    "tool": "github_remove_label",
    "description": "Remove a label from a pull request or issue",
    "writes": true,
    "flags": [
      "--number <n>",
      "--label <label>",
      "--owner <owner>",
      "--repo <repo>",
      "--allow-write"
    ]
  },
  {
    "name": "add-assignees",
    "tool": "github_add_assignees",
    "description": "Add assignees to a pull request or issue",
    "writes": true,
    "flags": [
      "--number <n>",
      "--assignee <login>",
      "--owner <owner>",
      "--repo <repo>",
      "--allow-write"
    ]
  },
  {
    "name": "remove-assignees",
    "tool": "github_remove_assignees",
    "description": "Remove assignees from a pull request or issue",
    "writes": true,
    "flags": [
      "--number <n>",
      "--assignee <login>",
      "--owner <owner>",
      "--repo <repo>",
      "--allow-write"
    ]
  },
  {
    "name": "list-prs",
    "tool": "github_list_prs",
    "description": "List pull requests",
    "writes": false,
    "flags": [
      "--state <state>",
      "--head <branch>",
      "--base <branch>",
      "--author <login>",
      "--created-after <date>",
      "--created-before <date>",
      "--owner <owner>",
      "--repo <repo>"
    ]
  },
  {
    "name": "get-pr",
    "tool": "github_get_pr",
    "description": "Get a pull request by number",
    "writes": false,
    "flags": [
      "--number <n>",
      "--owner <owner>",
      "--repo <repo>"
    ]
  },
  {
    "name": "create-pr",
    "tool": "github_create_pr",
    "description": "Create a pull request",
    "writes": true,
    "flags": [
      "--title <title>",
      "--head <branch>",
      "--base <branch>",
      "--body <body>",
      "--body-file <path>",
      "--draft",
      "--owner <owner>",
      "--repo <repo>",
      "--owner <owner>",
      "--repo <repo>",
      "--allow-write"
    ]
  },
  {
    "name": "update-pr",
    "tool": "github_update_pr",
    "description": "Update a pull request",
    "writes": true,
