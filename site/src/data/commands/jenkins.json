[
  {
    "name": "pipeline list",
    "tool": "jenkins_pipeline_list",
    "description": "List all jobs on the Jenkins instance (or within a folder)",
    "writes": false,
    "connection": true,
    "flags": [
      "--folder <name>",
      "--instance <name>"
    ]
  },
  {
    "name": "pipeline get",
    "tool": "jenkins_pipeline_get",
    "description": "Get details for a specific job",
    "writes": false,
    "connection": true,
    "flags": [
      "<name>",
      "--instance <name>"
    ]
  },
  {
    "name": "pipeline run",
    "tool": "jenkins_pipeline_run",
    "description": "Trigger a build",
    "writes": true,
    "connection": true,
    "flags": [
      "<name>",
      "--parameter <k=v>",
      "--wait",
      "--timeout <s>",
      "--poll <s>",
      "--instance <name>",
      "--allow-write"
    ]
  },
  {
    "name": "pipeline runs",
    "tool": "jenkins_pipeline_runs",
    "description": "List recent builds for a job",
    "writes": false,
    "connection": true,
    "flags": [
      "<name>",
      "--limit <n>",
      "--instance <name>"
    ]
  },
  {
    "name": "run get",
    "tool": "jenkins_run_get",
    "description": "Get details for a specific build",
    "writes": false,
    "connection": true,
    "flags": [
      "<name>",
      "<number>",
      "--instance <name>"
    ]
  },
  {
    "name": "run logs",
    "tool": "jenkins_run_logs",
    "description": "Fetch console log for a build (consider --output-file for large logs)",
    "writes": false,
    "connection": true,
    "flags": [
      "<name>",
      "<number>",
      "--instance <name>"
    ]
  }
]
