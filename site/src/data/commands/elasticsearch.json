[
  {
    "name": "cluster health",
    "tool": "elasticsearch_cluster_health",
    "description": "Show cluster health (status, node and shard counts)",
    "writes": false,
    "connection": true,
    "flags": []
  },
  {
    "name": "index list",
    "tool": "elasticsearch_index_list",
    "description": "List indices with health, document count and size",
    "writes": false,
    "connection": true,
    "flags": [
      "--pattern <pattern>"
    ]
  },
  {
    "name": "index search",
    "tool": "elasticsearch_index_search",
    "description": "Search one or more indices with Query DSL JSON or a query string",
    "writes": false,
    "connection": true,
    "flags": [
      "<index>",
      "--query <json>",
      "--q <query-string>",
      "--sort <field:order>",
      "--source <fields>",
      "--limit <n>",
      "--offset <n>",
      "--timeout-ms <ms>"
    ]
  },
  {
    "name": "index count",
    "tool": "elasticsearch_index_count",
    "description": "Count documents matching a query",
    "writes": false,
    "connection": true,
    "flags": [
      "<index>",
      "--query <json>",
      "--q <query-string>"
    ]
  }
]
