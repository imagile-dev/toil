[
  {
    "name": "workspace list",
    "tool": "splitio_workspace_list",
    "description": "List all Split.IO workspaces",
    "writes": false,
    "connection": true,
    "flags": []
  },
  {
    "name": "environment list",
    "tool": "splitio_environment_list",
    "description": "List environments in a workspace",
    "writes": false,
    "connection": true,
    "flags": [
      "--ws <id>"
    ]
  },
  {
    "name": "flag list",
    "tool": "splitio_flag_list",
    "description": "List feature flags in a workspace",
    "writes": false,
    "connection": true,
    "flags": [
      "--limit <n>",
      "--offset <n>",
      "--flag-set <name>",
      "--ws <id>"
    ]
  },
  {
    "name": "flag get",
    "tool": "splitio_flag_get",
    "description": "Get a flag definition",
    "writes": false,
    "connection": true,
    "flags": [
      "<flag>",
      "--environment <id>",
      "--ws <id>"
    ]
  },
  {
    "name": "flag update",
    "tool": "splitio_flag_update",
    "description": "Submit a Change Request to replace a flag's full definition in an environment",
    "writes": true,
    "connection": true,
    "flags": [
      "<flag>",
      "--environment <id>",
      "--mnemonic <text>",
      "--description <text>",
      "--change-number <CHG>",
      "--approvers <ids>",
      "--rollout-status <id>",
      "--input-file <path>",
      "--ws <id>",
      "--allow-write"
    ]
  },
  {
    "name": "flag set-rule",
    "tool": "splitio_flag_set_rule",
    "description": "Change one targeting rule without altering the rest of the flag definition",
    "writes": true,
    "connection": true,
    "flags": [
      "<flag>",
      "--environment <id>",
      "--rule-index <n>",
      "--treatment <name>",
      "--weights <json>",
      "--mnemonic <text>",
      "--description <text>",
      "--change-number <CHG>",
      "--approvers <ids>",
      "--rollout-status <id>",
      "--ws <id>",
      "--allow-write"
    ]
  },
  {
    "name": "flag set-default",
    "tool": "splitio_flag_set_default",
    "description": "Update the fallback default rule for traffic matching no targeting rule",
    "writes": true,
    "connection": true,
    "flags": [
      "<flag>",
      "--environment <id>",
      "--treatment <name>",
      "--mnemonic <text>",
      "--description <text>",
      "--change-number <CHG>",
      "--approvers <ids>",
      "--rollout-status <id>",
      "--ws <id>",
      "--allow-write"
    ]
  },
  {
    "name": "flag toggle",
    "tool": "splitio_flag_toggle",
    "description": "Enable or disable a single flag via a Change Request",
    "writes": true,
    "connection": true,
    "flags": [
      "<flag>",
      "--environment <id>",
      "--enabled <bool>",
      "--mnemonic <text>",
      "--description <text>",
      "--change-number <CHG>",
      "--approvers <ids>",
      "--rollout-status <id>",
      "--ws <id>",
      "--allow-write"
    ]
  },
  {
    "name": "flag toggle-many",
    "tool": "splitio_flag_toggle_many",
    "description": "Enable or disable multiple flags from a JSON file (each creates its own Change Request)",
    "writes": true,
    "connection": true,
    "flags": [
      "--environment <id>",
      "--mnemonic <text>",
      "--description <text>",
      "--change-number <CHG>",
      "--approvers <ids>",
      "--rollout-status <id>",
      "--input-file <path>",
      "--ws <id>",
      "--allow-write"
    ]
  },
  {
    "name": "flag kill",
    "tool": "splitio_flag_kill",
    "description": "Submit a Change Request to kill (disable) a flag",
    "writes": true,
    "connection": true,
    "flags": [
      "<flag>",
      "--environment <id>",
      "--mnemonic <text>",
      "--description <text>",
      "--change-number <CHG>",
      "--approvers <ids>",
      "--rollout-status <id>",
      "--ws <id>",
      "--allow-write"
    ]
  },
  {
    "name": "flag restore",
    "tool": "splitio_flag_restore",
    "description": "Submit a Change Request to restore a killed flag",
    "writes": true,
    "connection": true,
    "flags": [
      "<flag>",
      "--environment <id>",
      "--mnemonic <text>",
      "--description <text>",
      "--change-number <CHG>",
      "--approvers <ids>",
      "--rollout-status <id>",
      "--ws <id>",
      "--allow-write"
    ]
  },
  {
    "name": "flag archive",
    "tool": null,
    "description": "Submit a Change Request to remove a flag's definition from an environment",
    "writes": true,
    "connection": true,
    "flags": [
      "<flag>",
      "--environment <id>",
      "--mnemonic <text>",
      "--description <text>",
      "--change-number <CHG>",
      "--approvers <ids>",
      "--rollout-status <id>",
      "--ws <id>",
      "--allow-write"
    ]
  },
  {
    "name": "change-request list",
    "tool": "splitio_change_request_list",
    "description": "List Change Requests for a workspace",
    "writes": false,
    "connection": true,
    "flags": [
      "--environment <id>",
      "--status <status>",
      "--limit <n>",
      "--offset <n>",
      "--after <marker>",
      "--ws <id>"
    ]
  },
  {
    "name": "change-request get",
    "tool": "splitio_change_request_get",
    "description": "Get a Change Request by ID",
    "writes": false,
    "connection": true,
    "flags": [
      "<id>"
    ]
  }
]
