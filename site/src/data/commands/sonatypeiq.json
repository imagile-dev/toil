    "connection": true,
    "flags": [
      "<public-id>"
    ]
  },
  {
    "name": "organization list",
    "tool": "sonatypeiq_organization_list",
    "description": "List all organizations in Sonatype IQ Server",
    "writes": false,
    "connection": true,
    "flags": []
  },
  {
    "name": "policy list",
    "tool": "sonatypeiq_policy_list",
    "description": "List all policies",
    "writes": false,
    "connection": true,
    "flags": [
      "--organization-id <id>"
    ]
  },
  {
    "name": "evaluate",
    "tool": "sonatypeiq_evaluate",
