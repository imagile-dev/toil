---
// Fonts are imported at the JS level, not via CSS @import: Vite only copies
// and rewrites the woff2 url()s when fontsource CSS comes through the module
// graph, and an @import inside a <style> block 404s in the built output.
// The wordmark's face: one weight, Latin only, since it only ever sets "toil".
import '@fontsource/fredoka/latin-600.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/fira-code/400.css';
import '@fontsource/fira-code/500.css';
import '@fontsource/archivo/500.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteSearch from '../components/SiteSearch.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'toil is the token-efficient alternative to MCP: one CLI for enterprise tools and databases, with compact JSON envelopes, --select for only the fields a task needs, and a skill the agent reads on demand instead of every tool schema up front. toil mcp stays available.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === 'toil' ? 'toil — the token-efficient alternative to MCP' : `${title} — toil`;
const ogImage = new URL(url('/og.png'), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0f1115" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:site_name" content="toil" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <SiteSearch />
    <dialog class="powershell-man" id="powershell-man" aria-labelledby="powershell-man-title" data-game-url={url('/ui/app/#/powershell-man')}>
      <div class="powershell-man__bar"><h2 id="powershell-man-title">Powershell Man · Esc pauses</h2><button type="button" data-game-close class="tap">Close game</button></div>
      <iframe title="Powershell Man game" data-game-frame></iframe>
    </dialog>
    <script src="../scripts/motion.js"></script>
    <script src="../scripts/powershell-man.ts"></script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  .skip {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 100;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-weight: 500;
  }
  .skip:focus { top: 1rem; }
  .powershell-man {
    position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0; background: #030b10; color: #e8f4f3; overflow: hidden;
  }
  .powershell-man[open] { display: grid; grid-template-rows: auto minmax(0, 1fr); }
  .powershell-man::backdrop { background: #030b10; }
  .powershell-man__bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.4rem 1rem; background: #0d1a23; border-bottom: 1px solid #27404a; }
  .powershell-man__bar h2 { margin: 0; font: 500 0.85rem var(--font-mono); }
  .powershell-man__bar button { min-height: 44px; padding: 0.4rem 0.7rem; border: 1px solid #41616d; border-radius: 5px; background: #102b39; color: #cce5e5; cursor: pointer; font: inherit; }
  .powershell-man__bar kbd { margin-left: 0.5rem; color: #91adb4; }
  .powershell-man iframe { display: block; width: 100%; height: 100%; border: 0; }
</style>
