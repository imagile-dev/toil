# Node build output
node_modules/
# dist/toil.js and the bundle it runs, dist/toil-lib.js, are committed, the last
# released toil, so a clone runs with no npm install; only the release PR rebuilds
# them. The rest of dist/ (dist/api.js, dist/api.d.ts, the metafiles) is build output.
dist/*
!dist/toil.js
!dist/toil-lib.js
coverage/
*.tgz
*.tsbuildinfo
.eslintcache
npm-debug.log*

# IDEs
.vs/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Local config and secrets
.env
.env.*
!.env.example
.envrc
*.local
.toil/

# Local databases created by tests or samples
*.db
*.db-shm
*.db-wal
*.sqlite

# Claude Code
.claude/settings.local.json
.claude/worktrees/
scheduled_tasks.lock

# OS
.DS_Store
Thumbs.db

# Image generation working folders (prompt records + PNG masters)
.claude/image-generation/*
!.claude/image-generation/style.md
!.claude/image-generation/style-cartoon.md
!.claude/image-generation/style-realm.md
!.claude/image-generation/style-sprawl.md
!.claude/image-generation/style-frontier.md
!.claude/image-generation/style-overworld.md

# Astro
site/.astro/
site/dist/

# Toil UI build output, and the preview copy the site build makes of it
ui/dist/
site/public/ui/app/

# Local design labs, never shipped
site/public/lab/

# Generated before typecheck, build and tests (scripts/gen-areas.mjs)
src/areas.generated.ts
src/skill-pages.generated.ts
src/areas/util/kit/bounded-worker.generated.ts

# Area stubs test/stub-area.test.ts writes and removes
test/.stubs/

# Scratch homes and output for local runs (ui/scripts/dev-real.mjs, ui/scripts/verify.mjs)
.scratch/
# npm run verify:ui's report and screenshots
ui/.verify/

# The ADO seed's map of seed keys to one organization's work item ids (ui/scripts/ado-seed/apply.mjs)
ui/scripts/ado-seed/ids.local.json
